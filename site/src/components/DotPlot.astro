---
// One row per relation, a 0–100% axis, one marker per method — easier to compare than grouped bars.
import { pct } from '../lib/format';

interface Props {
  rows: { name: string; values: (number | null)[]; note?: string }[];
  /** Drawn in reverse order so the first method sits on top; `ring` methods are hollow (reference values). */
  methods: { name: string; color: string; ring?: boolean }[];
  title: string;
}

const { rows, methods, title } = Astro.props;
const W = 720;
const label = 110;
const right = 16;
const rowH = 28;
const top = 8;
const H = top + rows.length * rowH + 26;
const sx = (v: number) => label + v * (W - label - right);
const ticks = [0, 0.25, 0.5, 0.75, 1];
---

<figure class="dots">
  <div class="legend">
    {
      methods.map((m) => (
        <span>
          <i class="key" style={m.ring ? `border:2px solid ${m.color}` : `background:${m.color}`} />
          {m.name}
        </span>
      ))
    }
  </div>
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={title}>
    {
      ticks.map((t) => (
        <g>
          <line x1={sx(t)} x2={sx(t)} y1={top} y2={H - 26} class={t === 0 ? 'base' : 'grid'} />
          <text x={sx(t)} y={H - 8} text-anchor="middle" class="tick">
            {pct(t, 0)}
          </text>
        </g>
      ))
    }
    {
      rows.map((r, i) => {
        const cy = top + i * rowH + rowH / 2;
        const tip = `${r.name}\n` + methods.map((m, j) => `${m.name}: ${pct(r.values[j])}`).join('\n') + (r.note ? `\n${r.note}` : '');
        const present = r.values.filter((v): v is number => v !== null);
        return (
          <g class="row" data-tip={tip} tabindex="0">
            <rect x="0" y={cy - rowH / 2} width={W} height={rowH} class="band" />
            <text x={label - 10} y={cy + 4} text-anchor="end" class="name">
              {r.name}
            </text>
            <line x1={sx(Math.min(...present))} x2={sx(Math.max(...present))} y1={cy} y2={cy} class="span" />
            {[...methods.keys()].reverse().map((j) => {
              const m = methods[j]!;
              const v = r.values[j];
              if (v === null || v === undefined) return null;
              return m.ring ? (
                <circle cx={sx(v)} cy={cy} r="8" fill="none" stroke={m.color} stroke-width="2" />
              ) : (
                <circle cx={sx(v)} cy={cy} r={j === 0 ? 5.5 : 5} fill={m.color} stroke="var(--surface)" stroke-width="2" />
              );
            })}
          </g>
        );
      })
    }
  </svg>
</figure>

<style>
  .dots {
    margin: 0;
  }

  svg {
    width: 100%;
    height: auto;
    display: block;
    overflow: visible;
  }

  .grid {
    stroke: var(--grid);
  }

  .base {
    stroke: var(--axis);
  }

  .tick {
    fill: var(--muted);
    font-size: 12px;
  }

  .name {
    fill: var(--ink-2);
    font-size: 13px;
    font-family: var(--mono);
  }

  .span {
    stroke: var(--axis);
    stroke-width: 2;
  }

  .band {
    fill: transparent;
  }

  .row:hover .band,
  .row:focus .band {
    fill: var(--surface-2);
  }

  .row:focus {
    outline: none;
  }
</style>
