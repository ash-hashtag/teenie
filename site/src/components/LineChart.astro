---
// Static SVG line chart on a 0..max y-axis; hovering a column shows every series' value there.
interface Series {
  name: string;
  color: string; // CSS custom property, e.g. 'var(--series-1)'
  points: { x: number; y: number }[];
}

interface Props {
  series: Series[];
  yMax?: number;
  yTicks?: number[];
  yFormat?: 'pct' | 'raw';
  xLabel: string;
  title: string;
  height?: number;
}

const { series, yMax = 1, yTicks = [0, 0.25, 0.5, 0.75, 1], yFormat = 'pct', xLabel, title, height = 260 } = Astro.props;
const W = 720;
const H = height;
const m = { l: 46, r: 92, t: 12, b: 36 };
const xs = series[0]?.points.map((p) => p.x) ?? [];
const xMax = Math.max(...xs);
const xMin = Math.min(...xs, 0);
const sx = (x: number) => m.l + ((x - xMin) / (xMax - xMin)) * (W - m.l - m.r);
const sy = (y: number) => m.t + (1 - y / yMax) * (H - m.t - m.b);
const fmt = (y: number) => (yFormat === 'pct' ? `${Math.round(y * 1000) / 10}%` : y.toFixed(3));
const step = xMax > 2000 ? 500 : xMax > 500 ? 250 : 100;
const xTicks = Array.from({ length: Math.floor(xMax / step) + 1 }, (_, i) => i * step);
const path = (s: Series) => s.points.map((p, i) => `${i ? 'L' : 'M'}${sx(p.x).toFixed(1)},${sy(p.y).toFixed(1)}`).join('');
const columns = xs.map((x, i) => ({
  x,
  left: i === 0 ? m.l : (sx(xs[i - 1]!) + sx(x)) / 2,
  right: i === xs.length - 1 ? W - m.r : (sx(x) + sx(xs[i + 1]!)) / 2,
  tip: `update ${x}\n` + series.map((s) => `${s.name}: ${fmt(s.points[i]!.y)}`).join('\n'),
}));
---

<figure class="chart">
  <figcaption class="sr">{title}</figcaption>
  {
    series.length > 1 && (
      <div class="legend">
        {series.map((s) => (
          <span>
            <i class="key line" style={`background:${s.color}`} />
            {s.name}
          </span>
        ))}
      </div>
    )
  }
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={title}>
    {
      yTicks.map((t) => (
        <g>
          <line x1={m.l} x2={W - m.r} y1={sy(t)} y2={sy(t)} class={t === 0 ? 'base' : 'grid'} />
          <text x={m.l - 8} y={sy(t) + 4} text-anchor="end" class="tick">
            {fmt(t)}
          </text>
        </g>
      ))
    }
    {
      xTicks.map((t) => (
        <text x={sx(t)} y={H - m.b + 18} text-anchor="middle" class="tick">
          {t.toLocaleString('en-US')}
        </text>
      ))
    }
    <text x={(m.l + W - m.r) / 2} y={H - 2} text-anchor="middle" class="axis-label">{xLabel}</text>
    {series.map((s) => <path d={path(s)} fill="none" stroke={s.color} stroke-width="2" stroke-linejoin="round" stroke-linecap="round" />)}
    {
      series.map((s) => {
        const last = s.points[s.points.length - 1]!;
        return (
          <g>
            <circle cx={sx(last.x)} cy={sy(last.y)} r="4" fill={s.color} stroke="var(--surface)" stroke-width="2" />
            <text x={sx(last.x) + 9} y={sy(last.y) + 4} class="end">
              {fmt(last.y)}
            </text>
          </g>
        );
      })
    }
    {
      columns.map((c, i) => (
        <g class="col" data-tip={c.tip}>
          <rect x={c.left} y={m.t} width={Math.max(1, c.right - c.left)} height={H - m.t - m.b} fill="transparent" />
          <line x1={sx(c.x)} x2={sx(c.x)} y1={m.t} y2={H - m.b} class="cross" />
          {series.map((s) => (
            <circle cx={sx(c.x)} cy={sy(s.points[i]!.y)} r="4" fill={s.color} stroke="var(--surface)" stroke-width="2" class="cross" />
          ))}
        </g>
      ))
    }
  </svg>
</figure>

<style>
  .chart {
    margin: 0;
  }

  svg {
    width: 100%;
    height: auto;
    display: block;
    overflow: visible;
  }

  .grid {
    stroke: var(--grid);
    stroke-width: 1;
  }

  .base {
    stroke: var(--axis);
    stroke-width: 1;
  }

  .tick,
  .axis-label {
    fill: var(--muted);
    font-size: 12px;
    font-variant-numeric: tabular-nums;
  }

  .end {
    fill: var(--ink-2);
    font-size: 12px;
    font-weight: 600;
  }

  .cross {
    visibility: hidden;
    stroke: var(--axis);
  }

  .col:hover .cross {
    visibility: visible;
  }

  .sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }
</style>
