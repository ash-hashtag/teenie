---
// The current model: examples encoded once; the question refines an 8-bit guess over rounds with the same weights.
interface Props {
  layers: number;
  rounds: number;
  heads: number;
}

const { layers, rounds, heads } = Astro.props;
const box = [
  { id: 'ex', x: 20, y: 30, w: 190, h: 58, t: ['999 examples', 'a, b, c as 24 bits'], kind: 'data' },
  { id: 'enc', x: 20, y: 140, w: 190, h: 58, t: ['Example encoder', 'bilinear · run once'], kind: '' },
  { id: 'vec', x: 20, y: 250, w: 190, h: 58, t: ['999 fixed vectors', 'kept for every round'], kind: 'data' },
  { id: 'q', x: 290, y: 30, w: 210, h: 58, t: ['Question', 'a, b + current 8-bit guess'], kind: 'data' },
  { id: 'inp', x: 290, y: 130, w: 210, h: 52, t: ['Question input', 'bilinear: multiplies its own bits'], kind: '' },
  { id: 'look', x: 290, y: 215, w: 210, h: 66, t: [`Look layers × ${layers}`, `attention to the examples (${heads} heads)`, '+ gated feed-forward'], kind: 'att' },
  { id: 'mem', x: 290, y: 315, w: 210, h: 52, t: ['Memory', 'GRU cell, carried to the next round'], kind: '' },
  { id: 'read', x: 580, y: 315, w: 180, h: 52, t: ['Readout', 'new 8-bit guess'], kind: '' },
  { id: 'ans', x: 580, y: 30, w: 180, h: 58, t: ['Answer', `after round ${rounds} + confidence`], kind: 'data' },
];
type Box = (typeof box)[number];
const by = Object.fromEntries(box.map((b) => [b.id, b])) as Record<string, Box>;
const r = (id: string) => by[id]!.x + by[id]!.w;
const bottom = (id: string) => by[id]!.y + by[id]!.h;
const cx = (id: string) => by[id]!.x + by[id]!.w / 2;
const cy = (id: string) => by[id]!.y + by[id]!.h / 2;
---

<div class="scroll">
  <svg viewBox="0 0 800 400" role="img" aria-labelledby="loop-title loop-desc">
    <title id="loop-title">The current model</title>
    <desc id="loop-desc">
      The 999 examples are encoded once into fixed vectors. The question holds a guess for all 8 answer bits. Each
      round, the question input multiplies its own bits, look layers attend to the fixed example vectors, a GRU memory
      is updated and the readout writes a new guess; the same weights run every round. After the last round the guess is
      the answer.
    </desc>
    <defs>
      <marker id="loop-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M0,0 L10,5 L0,10 z" fill="var(--muted)"></path>
      </marker>
    </defs>
    <rect x="270" y="112" width="510" height="276" rx="14" class="round" />
    <text x="282" y="380" class="round-label">one round · same weights · × {rounds}</text>
    <g class="edges">
      <path d={`M${cx('ex')},${bottom('ex')} V${by.enc!.y - 4}`} />
      <path d={`M${cx('enc')},${bottom('enc')} V${by.vec!.y - 4}`} />
      <path d={`M${cx('q')},${bottom('q')} V${by.inp!.y - 4}`} />
      <path d={`M${cx('inp')},${bottom('inp')} V${by.look!.y - 4}`} />
      <path d={`M${cx('look')},${bottom('look')} V${by.mem!.y - 4}`} />
      <path d={`M${r('mem')},${cy('mem')} H${by.read!.x - 4}`} />
      <path d={`M${r('vec')},${cy('vec')} H${by.look!.x - 4}`} />
      <path class="loop" d={`M${cx('read')},${by.read!.y} V100 H540 V${cy('q')} H${r('q') + 4}`} />
      <path class="loop" d={`M${r('read')},${cy('read')} H790 V${cy('ans')} H${r('ans') + 4}`} />
    </g>
    <g class="labels">
      <text x={r('vec') + 12} y={cy('vec') - 8}>keys &amp; values</text>
      <text x="678" y="230">next round</text>
      <text x="700" y="170">after the</text>
      <text x="700" y="186">last round</text>
    </g>
    {
      box.map((b) => (
        <g class:list={['node', b.kind]}>
          <rect x={b.x} y={b.y} width={b.w} height={b.h} rx="10" />
          {b.t.map((line, i) => (
            <text x={b.x + b.w / 2} y={b.y + b.h / 2 + (i - (b.t.length - 1) / 2) * 17 + 5} text-anchor="middle" class={i === 0 ? 'head' : 'sub'}>
              {line}
            </text>
          ))}
        </g>
      ))
    }
  </svg>
</div>

<style>
  .scroll {
    overflow-x: auto;
  }

  svg {
    min-width: 600px;
    width: 100%;
    height: auto;
    display: block;
  }

  .round {
    fill: var(--surface-2);
    stroke: var(--grid);
  }

  .round-label {
    fill: var(--muted);
    font-size: 12px;
  }

  .node rect {
    fill: var(--surface);
    stroke: var(--axis);
  }

  .node.data rect {
    fill: var(--page);
  }

  .node.att rect {
    fill: var(--wash-1);
    stroke: var(--series-1);
    stroke-width: 1.5;
  }

  .head {
    fill: var(--ink);
    font-size: 14px;
    font-weight: 600;
  }

  .sub {
    fill: var(--ink-2);
    font-size: 12px;
  }

  .edges path {
    fill: none;
    stroke: var(--muted);
    stroke-width: 1.5;
    marker-end: url(#loop-arrow);
  }

  .edges .loop {
    stroke: var(--series-2);
  }

  .labels text {
    fill: var(--muted);
    font-size: 12px;
  }
</style>
