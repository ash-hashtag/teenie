---
import { progress } from '../lib/data';
// The middle band at 32 bits: bits recovered (0 = a blind guess, 32 = certain and right) per group of held-out
// relations, the model next to the best lookup and to models fitted to each task's own 999 examples. Each row opens to
// its relations.
const middle = progress.middle;
const LABELS: Record<string, string> = {
  random: 'Random 6–10-step expressions',
  'floor: products': 'Products (floor)',
  automaton: 'Cellular automata (rules 30, 110)',
  deep: 'Deep expressions with constants',
  sbox: 'A random S-box inside arithmetic',
  'data-dependent': 'Data-dependent steps',
  loops: 'Loops',
  mixes: 'Rotation / xor / multiply mixes',
  'arx ladder': 'Add-rotate-xor rounds 1–4',
  'control: hash': 'Control: hashes (must be ≈ 0)',
};
const NOTES: Record<string, string> = {
  random: 'A fresh random expression of 6–10 operations every episode, longer than anything trained.',
  'arx ladder': 'x = rotl(x ^ k, 7) + y; y = rotl(y, 3) ^ x, repeated 1–4 times with fresh random round keys k; the answer is x.',
  sbox: 'A random 4-bit substitution table applied to every nibble of a ^ b, then added to a; a new table every episode.',
  automaton: 'Rule 30 or rule 110 run for 2 or 4 steps on the bits of a (wrapping around), then xor b.',
  'control: hash': 'Functions built to scramble; nothing should beat chance.',
};
const order = ['random', 'floor: products', 'automaton', 'deep', 'sbox', 'data-dependent', 'loops', 'mixes', 'arx ladder', 'control: hash'];
const groups = middle ? order.map((g) => middle.groups.find((x) => x.group === g)).filter((g) => g !== undefined) : [];
const bits = (x: number | null | undefined) => (x == null ? '—' : (Math.abs(x) < 0.05 ? 0 : x).toFixed(1));
const best = (g: { lookup: number | null; trees: number | null; mlp: number | null }) =>
  Math.max(g.lookup ?? -99, g.trees ?? -99, g.mlp ?? -99);
const tone = (model: number | null, rival: number) => ((model ?? 0) > rival + 0.5 ? 'win' : (model ?? 0) < rival - 0.5 ? 'lose' : '');
---

{middle && (
  <div class="middle" role="table" aria-label="The middle band at 32 bits">
    <div class="row head" role="row">
      <span role="columnheader">held-out group (click to see the rules)</span>
      <span class="num" role="columnheader">Teenie</span>
      <span class="num" role="columnheader">best lookup</span>
      <span class="num" role="columnheader">trees fitted per task</span>
      <span class="num" role="columnheader">small net fitted per task</span>
      <span class="num muted" role="columnheader">older model</span>
    </div>
    {groups.map((g) => (
      <details>
        <summary class="row" role="row">
          <span class="title"><span class="chev" aria-hidden="true">▸</span>{LABELS[g.group] ?? g.group}</span>
          <span class={`num ${tone(g.model, best(g))}`}><b>{bits(g.model)}</b></span>
          <span class="num">{bits(g.lookup)}</span>
          <span class="num">{bits(g.trees)}</span>
          <span class="num">{bits(g.mlp)}</span>
          <span class="num muted">{bits(g.older)}</span>
        </summary>
        <div class="inside">
          {NOTES[g.group] && <p class="small muted">{NOTES[g.group]}</p>}
          <table>
            <thead><tr><th>rule</th><th class="num">Teenie</th><th class="num">exact</th><th class="num">lookup</th><th class="num">trees</th><th class="num">small net</th></tr></thead>
            <tbody>
              {g.rows.map((r) => (
                <tr>
                  <td><code>{r.name}</code></td>
                  <td class={`num ${tone(r.model, best(r))}`}><b>{bits(r.model)}</b></td>
                  <td class="num">{r.exact == null ? '—' : `${(r.exact * 100).toFixed(0)}%`}</td>
                  <td class="num">{bits(r.lookup)}</td>
                  <td class="num">{bits(r.trees)}</td>
                  <td class="num">{bits(r.mlp)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </details>
    ))}
  </div>
)}

<style>
  .middle {
    display: grid;
    overflow-x: auto;
  }

  .row {
    display: grid;
    grid-template-columns: minmax(15rem, 2.4fr) repeat(5, minmax(5.5rem, 1fr));
    gap: 0.5rem;
    align-items: baseline;
    padding: 0.55rem 0.4rem;
    border-bottom: 1px solid var(--axis);
    min-width: 48rem;
  }

  .head {
    font-weight: 600;
    font-size: 0.85rem;
    color: var(--ink-2);
  }

  summary.row {
    cursor: pointer;
    list-style: none;
  }

  summary.row::-webkit-details-marker {
    display: none;
  }

  summary.row:hover {
    background: color-mix(in oklab, var(--series-1) 6%, transparent);
  }

  .chev {
    display: inline-block;
    width: 1rem;
    color: var(--muted);
    transition: transform 0.15s;
  }

  details[open] .chev {
    transform: rotate(90deg);
  }

  .num {
    text-align: right;
    font-variant-numeric: tabular-nums;
  }

  .inside {
    padding: 0.3rem 0.4rem 0.9rem 1.4rem;
    border-bottom: 1px solid var(--axis);
    min-width: 46rem;
  }

  .inside table {
    font-size: 0.85rem;
  }

  .win b {
    color: var(--good);
  }

  .lose b {
    color: var(--bad);
  }
</style>
