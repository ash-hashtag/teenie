---
import showcase from '../data/showcase.json';
// Spot-the-rule puzzles from real episodes of the release model (export_showcase.py). Each rule has six recorded
// episodes with 24 of their 999 examples and all 16 questions with the model's actual answers; every puzzle shows a
// random few examples in random order and one random question, so the numbers change on each visit.
const puzzles = showcase.rules.filter((r) => r.puzzle);
---

<section class="puzzle card" data-puzzles={JSON.stringify(puzzles)} aria-label="Spot the rule">
  <p class="eyebrow" data-role="puzzle-title">Puzzle</p>
  <div class="body">
    <div>
      <p class="hint small muted">These numbers follow one hidden rule. Can you work it out?</p>
      <table class="rows">
        <colgroup><col class="col-n" /><col class="col-n" /><col class="col-arrow" /><col class="col-c" /></colgroup>
        <thead><tr><th class="num">a</th><th class="num">b</th><th></th><th class="num">c</th></tr></thead>
        <tbody data-role="puzzle-rows"></tbody>
        <tfoot>
          <tr class="question"><td class="num" data-role="qa"></td><td class="num" data-role="qb"></td><td>→</td><td class="num"><span class="mystery" data-role="qc">?</span></td></tr>
        </tfoot>
      </table>
    </div>
    <div class="side" aria-live="polite">
      <p class="placeholder small muted" data-role="placeholder">Make your guess, then press Show answer.</p>
      <p class="verdict" data-role="answer-box" hidden></p>
      <div class="rule-box" data-role="rule-box" hidden>
        <p class="rule"><code data-role="rule"></code></p>
        <p class="small muted" data-role="rule-note"></p>
        <a class="small" data-role="rule-try" href="/try/">Test it on this rule yourself →</a>
      </div>
    </div>
  </div>
  <div class="actions">
    <button class="btn primary" type="button" data-role="show-answer">Show answer</button>
    <button class="btn secondary" type="button" data-role="show-rule" disabled>Reveal the rule</button>
    <button class="btn ghost next" type="button" data-role="puzzle-next">Another puzzle ↻</button>
  </div>
</section>

<script>
  type Episode = { examples: number[][]; questions: number[][] };
  type View = { rows: number[][]; a: number; b: number; truth: number; answer: number };
  type Rule = { shown: string; formula: string; episodes: Episode[]; right: number; total: number };
  const root = document.querySelector<HTMLElement>('.puzzle')!;
  const puzzles = JSON.parse(root.dataset.puzzles!) as Rule[];
  const $ = <T extends Element>(role: string) => root.querySelector<T>(`[data-role="${role}"]`)!;
  const level = (rule: Rule) => (rule.shown.length <= 18 ? 'warm-up' : rule.shown.length <= 26 ? 'tricky' : 'hard');
  const random = (n: number) => Math.floor(Math.random() * n);
  const pick = <T,>(xs: T[]): T => xs[random(xs.length)]!;
  const SHOWN = 7;

  // A random few of the episode's examples, shuffled, and one of its questions with the model's recorded answer.
  function draw(rule: Rule): View {
    const e = pick(rule.episodes);
    const rows = [...e.examples];
    for (let i = rows.length - 1; i > 0; i--) {
      const j = random(i + 1);
      [rows[i], rows[j]] = [rows[j]!, rows[i]!];
    }
    const [a, b, truth, answer] = pick(e.questions) as [number, number, number, number];
    return { rows: rows.slice(0, SHOWN), a, b, truth, answer };
  }

  let current = random(puzzles.length);
  let episode = draw(puzzles[current]!);

  function show(): void {
    const p = puzzles[current]!;
    $('puzzle-title').textContent = `Puzzle · ${level(p)}`;
    $('puzzle-rows').innerHTML = episode.rows
      .map(([a, b, c]) => `<tr><td class="num">${a}</td><td class="num">${b}</td><td>→</td><td class="num">${c}</td></tr>`)
      .join('');
    $('qa').textContent = String(episode.a);
    $('qb').textContent = String(episode.b);
    $('qc').textContent = '?';
    $('qc').className = 'mystery';
    for (const role of ['answer-box', 'rule-box']) $<HTMLElement>(role).hidden = true;
    $<HTMLElement>('placeholder').hidden = false;
    $<HTMLButtonElement>('show-answer').disabled = false;
    $<HTMLButtonElement>('show-rule').disabled = true;
    step('show-answer');
  }

  // The button for the next step is the filled one, and focus follows it so keyboard users never lose their place.
  function step(next: 'show-answer' | 'show-rule' | 'puzzle-next', focus = false): void {
    $('show-answer').classList.toggle('primary', next === 'show-answer');
    $('show-rule').classList.toggle('primary', next === 'show-rule');
    $('show-rule').classList.toggle('secondary', next !== 'show-rule');
    $('puzzle-next').classList.toggle('primary', next === 'puzzle-next');
    $('puzzle-next').classList.toggle('ghost', next !== 'puzzle-next');
    if (focus) $<HTMLButtonElement>(next).focus();
  }

  $('show-answer').addEventListener('click', () => {
    const ok = episode.answer === episode.truth;
    $('qc').textContent = String(episode.answer);
    $('qc').className = ok ? 'mystery solved' : 'mystery missed';
    $('answer-box').textContent = ok
      ? `Teenie says ${episode.answer}, and that's right. It read 999 examples like these.`
      : `Teenie says ${episode.answer}; the right answer is ${episode.truth}. Wrong this time.`;
    $<HTMLElement>('answer-box').hidden = false;
    $<HTMLElement>('placeholder').hidden = true;
    $<HTMLButtonElement>('show-answer').disabled = true;
    $<HTMLButtonElement>('show-rule').disabled = false;
    step('show-rule', true);
  });

  $('show-rule').addEventListener('click', () => {
    const p = puzzles[current]!;
    $('rule').textContent = `c = ${p.shown}`;
    $('rule-note').textContent = `Over 512 fresh questions with numbers this size, Teenie got ${Math.round((100 * p.right) / p.total)}% exactly right.`;
    $<HTMLAnchorElement>('rule-try').href = `/try/?rule=${encodeURIComponent(p.formula)}&width=16&small=1`;
    $<HTMLElement>('rule-box').hidden = false;
    $<HTMLButtonElement>('show-rule').disabled = true;
    step('puzzle-next', true);
  });

  $('puzzle-next').addEventListener('click', () => {
    let next = random(puzzles.length);
    if (puzzles.length > 1) while (next === current) next = random(puzzles.length);
    current = next;
    episode = draw(puzzles[current]!);
    show();
    $<HTMLButtonElement>('show-answer').focus();
  });
  show();
</script>

<style>
  .puzzle {
    display: grid;
    gap: 0.6rem;
  }

  .body {
    display: grid;
    grid-template-columns: 22rem minmax(0, 1fr);
    gap: 1.5rem;
    align-items: start;
  }

  @media (max-width: 720px) {
    .body {
      grid-template-columns: 1fr;
    }
  }

  .hint {
    margin: 0 0 0.4rem;
  }

  /* Fixed widths: revealing the answer never moves the numbers. */
  .rows {
    table-layout: fixed;
    width: 21rem;
    max-width: 100%;
    font: 1.15rem var(--mono);
    font-variant-numeric: tabular-nums;
  }

  .rows .col-n {
    width: 5.5rem;
  }

  .rows .col-arrow {
    width: 2.5rem;
  }

  .rows .col-c {
    width: 7.5rem;
  }

  .rows td,
  .rows th {
    padding: 0.2rem 0.6rem;
    white-space: nowrap;
  }

  .rows td:nth-child(3) {
    color: var(--muted);
    text-align: center;
  }

  .question td {
    border-top: 2px solid var(--axis);
    font-weight: 700;
  }

  .mystery {
    display: inline-block;
    width: 6.5ch;
    text-align: right;
    padding: 0 0.3rem;
    border-radius: 4px;
    box-sizing: border-box;
    background: color-mix(in oklab, var(--series-1) 15%, transparent);
  }

  .mystery.solved {
    background: color-mix(in oklab, var(--good) 25%, transparent);
  }

  .mystery.missed {
    background: color-mix(in oklab, var(--bad) 25%, transparent);
  }

  .side {
    display: grid;
    gap: 0.7rem;
    align-content: start;
    min-height: 9.5rem; /* room for the answer and the rule, so nothing below moves */
  }

  @media (max-width: 720px) {
    .side {
      min-height: 12rem; /* the same text wraps onto more lines on a phone */
    }
  }

  .placeholder {
    margin: 0;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    padding-top: 0.6rem;
    border-top: 1px solid var(--axis);
  }

  .actions button:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  .eyebrow {
    margin: 0;
  }

  .btn {
    font: inherit;
    font-weight: 600;
    border-radius: 8px;
    padding: 0.55rem 1rem;
    cursor: pointer;
    border: 1px solid var(--series-1);
    background: none;
    color: var(--series-1);
    transition: background 0.15s, color 0.15s, opacity 0.15s;
  }

  .btn.primary {
    background: var(--series-1);
    color: #fff;
  }

  .btn.ghost {
    border-color: var(--axis);
    color: var(--ink);
  }

  .btn:focus-visible {
    outline: 2px solid var(--series-1);
    outline-offset: 2px;
  }

  .btn:not(:disabled):hover {
    filter: brightness(1.06);
  }

  /* the next puzzle sits apart, on the right */
  .btn.next {
    margin-left: auto;
  }

  .verdict {
    margin: 0;
  }

  .rule {
    margin: 0;
  }

  .rule code {
    font-size: 1.1rem;
  }

  .rule-box p {
    margin: 0 0 0.4rem;
  }
</style>
