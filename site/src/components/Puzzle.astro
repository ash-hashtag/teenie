---
import showcase from '../data/showcase.json';
// Spot-the-rule puzzles: the task Teenie does, for a person to try. Each puzzle makes 999 examples of a hidden rule in the
// browser (a, b below 256, answers 16 bits wide, with the Try it page's evaluator), shows a few, asks for one more, and
// lets the visitor page through all 999 if they want. The answer shown is the rule's, not the model's; the rule's note
// gives the release model's measured rate on the same kind of episode (export_showcase.py).
const puzzles = showcase.rules
  .filter((r) => r.puzzle)
  .map((r) => ({ shown: r.shown, formula: r.formula, rate: Math.round((100 * r.right) / r.total) }));
---

<section class="puzzle card" data-puzzles={JSON.stringify(puzzles)} aria-label="Spot the rule">
  <p class="eyebrow" data-role="puzzle-title">Puzzle</p>
  <div class="body">
    <div>
      <p class="hint small muted">These numbers follow one hidden rule. Can you work out the last one?</p>
      <table class="rows">
        <colgroup><col class="col-n" /><col class="col-n" /><col class="col-arrow" /><col class="col-c" /></colgroup>
        <thead><tr><th class="num">a</th><th class="num">b</th><th></th><th class="num">c</th></tr></thead>
        <tbody data-role="puzzle-rows"></tbody>
        <tfoot>
          <tr class="question"><td class="num" data-role="qa"></td><td class="num" data-role="qb"></td><td>→</td><td class="num"><span class="mystery" data-role="qc">?</span></td></tr>
        </tfoot>
      </table>
      <button class="link small" type="button" data-role="all-toggle" aria-expanded="false" aria-controls="puzzle-all">See all 999 examples ↓</button>
    </div>
    <div class="side" aria-live="polite">
      <p class="placeholder small muted" data-role="placeholder">Make your guess, then press Show answer. Stuck? Look at more examples.</p>
      <p class="verdict" data-role="answer-box" hidden></p>
      <div class="rule-box" data-role="rule-box" hidden>
        <p class="rule"><code data-role="rule"></code></p>
        <p class="small muted" data-role="rule-note"></p>
        <a class="small" data-role="rule-try" href="/try/">Watch Teenie work it out →</a>
      </div>
    </div>
  </div>
  <div class="actions">
    <button class="btn primary" type="button" data-role="show-answer">Show answer</button>
    <button class="btn secondary" type="button" data-role="show-rule" disabled>Reveal the rule</button>
    <button class="btn ghost next" type="button" data-role="puzzle-next">Another puzzle ↻</button>
  </div>
  <div class="all" id="puzzle-all" data-role="all" hidden>
    <div class="pager">
      <button class="btn ghost small-btn" type="button" data-role="all-prev" aria-label="Previous examples">←</button>
      <span class="small muted" data-role="all-label"></span>
      <button class="btn ghost small-btn" type="button" data-role="all-next" aria-label="Next examples">→</button>
    </div>
    <table class="rows all-rows">
      <colgroup><col class="col-i" /><col class="col-n" /><col class="col-n" /><col class="col-arrow" /><col class="col-c" /></colgroup>
      <thead><tr><th class="num">#</th><th class="num">a</th><th class="num">b</th><th></th><th class="num">c</th></tr></thead>
      <tbody data-role="all-rows"></tbody>
    </table>
  </div>
</section>

<script>
  import { evaluate, parse } from '../lib/expression';

  type Rule = { shown: string; formula: string; rate: number };
  const COUNT = 999;
  const SHOWN = 7;
  const PAGE = 10; // a page fits on screen, so paging is all it takes
  const WIDTH = 16;
  const root = document.querySelector<HTMLElement>('.puzzle')!;
  const puzzles = JSON.parse(root.dataset.puzzles!) as Rule[];
  const $ = <T extends Element>(role: string) => root.querySelector<T>(`[data-role="${role}"]`)!;
  const level = (rule: Rule) => (rule.shown.length <= 18 ? 'warm-up' : rule.shown.length <= 26 ? 'tricky' : 'hard');
  const random = (n: number) => Math.floor(Math.random() * n);

  // 999 examples of the rule on fresh random a, b below 256, plus one question that is not among them.
  function episode(rule: Rule): { examples: number[][]; question: number[] } {
    const tree = parse(rule.formula);
    const seen = new Set<number>();
    const rows: number[][] = [];
    while (rows.length < COUNT + 1) {
      const a = random(256);
      const b = random(256);
      if (seen.has(a * 256 + b)) continue;
      seen.add(a * 256 + b);
      rows.push([a, b, Number(evaluate(tree, BigInt(a), BigInt(b), WIDTH))]);
    }
    return { examples: rows.slice(0, COUNT), question: rows[COUNT]! };
  }

  let current = random(puzzles.length);
  let made = episode(puzzles[current]!);
  let page = 0;

  function show(): void {
    const p = puzzles[current]!;
    $('puzzle-title').textContent = `Puzzle · ${level(p)}`;
    $('puzzle-rows').innerHTML = made.examples
      .slice(0, SHOWN)
      .map(([a, b, c]) => `<tr><td class="num">${a}</td><td class="num">${b}</td><td>→</td><td class="num">${c}</td></tr>`)
      .join('');
    $('qa').textContent = String(made.question[0]);
    $('qb').textContent = String(made.question[1]);
    $('qc').textContent = '?';
    $('qc').className = 'mystery';
    for (const role of ['answer-box', 'rule-box']) $<HTMLElement>(role).hidden = true;
    $<HTMLElement>('placeholder').hidden = false;
    $<HTMLButtonElement>('show-answer').disabled = false;
    $<HTMLButtonElement>('show-rule').disabled = true;
    page = 0;
    showAll();
    step('show-answer');
  }

  function showAll(): void {
    const pages = Math.ceil(COUNT / PAGE);
    page = Math.min(Math.max(page, 0), pages - 1);
    const start = page * PAGE;
    $('all-rows').innerHTML = made.examples
      .slice(start, start + PAGE)
      .map(([a, b, c], k) => `<tr><td class="num muted">${start + k + 1}</td><td class="num">${a}</td><td class="num">${b}</td><td>→</td><td class="num">${c}</td></tr>`)
      .join('');
    $('all-label').textContent = `${start + 1}–${Math.min(start + PAGE, COUNT)} of ${COUNT}`;
    $<HTMLButtonElement>('all-prev').disabled = page === 0;
    $<HTMLButtonElement>('all-next').disabled = page === pages - 1;
  }

  // The button for the next step is the filled one, and focus follows it so keyboard users never lose their place.
  function step(next: 'show-answer' | 'show-rule' | 'puzzle-next', focus = false): void {
    $('show-answer').classList.toggle('primary', next === 'show-answer');
    $('show-rule').classList.toggle('primary', next === 'show-rule');
    $('show-rule').classList.toggle('secondary', next !== 'show-rule');
    $('puzzle-next').classList.toggle('primary', next === 'puzzle-next');
    $('puzzle-next').classList.toggle('ghost', next !== 'puzzle-next');
    if (focus) $<HTMLButtonElement>(next).focus();
  }

  $('all-toggle').addEventListener('click', () => {
    const box = $<HTMLElement>('all');
    box.hidden = !box.hidden;
    $('all-toggle').setAttribute('aria-expanded', String(!box.hidden));
    $('all-toggle').textContent = box.hidden ? 'See all 999 examples ↓' : 'Hide the 999 examples ↑';
    if (!box.hidden) box.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  });
  $('all-prev').addEventListener('click', () => {
    page--;
    showAll();
  });
  $('all-next').addEventListener('click', () => {
    page++;
    showAll();
  });

  $('show-answer').addEventListener('click', () => {
    $('qc').textContent = String(made.question[2]);
    $('qc').className = 'mystery revealed';
    $('answer-box').textContent = `The answer is ${made.question[2]}. Did you get it?`;
    $<HTMLElement>('answer-box').hidden = false;
    $<HTMLElement>('placeholder').hidden = true;
    $<HTMLButtonElement>('show-answer').disabled = true;
    $<HTMLButtonElement>('show-rule').disabled = false;
    step('show-rule', true);
  });

  $('show-rule').addEventListener('click', () => {
    const p = puzzles[current]!;
    $('rule').textContent = `c = ${p.shown}`;
    $('rule-note').textContent = `This is Teenie's job: from 999 examples like these, answer new questions. On this rule it gets ${p.rate}% exactly right.`;
    $<HTMLAnchorElement>('rule-try').href = `/try/?rule=${encodeURIComponent(p.formula)}&width=16&small=1`;
    $<HTMLElement>('rule-box').hidden = false;
    $<HTMLButtonElement>('show-rule').disabled = true;
    step('puzzle-next', true);
  });

  $('puzzle-next').addEventListener('click', () => {
    let next = random(puzzles.length);
    if (puzzles.length > 1) while (next === current) next = random(puzzles.length);
    current = next;
    made = episode(puzzles[current]!);
    show();
    $<HTMLButtonElement>('show-answer').focus();
  });
  show();
</script>

<style>
  .puzzle {
    display: grid;
    grid-template-columns: minmax(0, 1fr); /* never wider than the card, whatever a long rule wants */
    gap: 0.6rem;
  }

  .body {
    display: grid;
    grid-template-columns: 22rem minmax(0, 1fr);
    gap: 1.5rem;
    align-items: start;
  }

  @media (max-width: 720px) {
    .body {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .hint {
    margin: 0 0 0.4rem;
  }

  /* Fixed widths: revealing the answer never moves the numbers. */
  .rows {
    table-layout: fixed;
    width: 21rem;
    max-width: 100%;
    font: 1.15rem var(--mono);
    font-variant-numeric: tabular-nums;
  }

  .rows .col-n {
    width: 5.5rem;
  }

  .rows .col-arrow {
    width: 2.5rem;
  }

  .rows .col-c {
    width: 7.5rem;
  }

  .rows .col-i {
    width: 3.5rem;
  }

  .rows td,
  .rows th {
    padding: 0.2rem 0.6rem;
    white-space: nowrap;
  }

  .rows td:nth-last-child(2) {
    color: var(--muted);
    text-align: center;
  }

  .question td {
    border-top: 2px solid var(--axis);
    font-weight: 700;
  }

  .mystery {
    display: inline-block;
    width: 6.5ch;
    text-align: right;
    padding: 0 0.3rem;
    border-radius: 4px;
    box-sizing: border-box;
    background: color-mix(in oklab, var(--series-1) 15%, transparent);
  }

  .mystery.revealed {
    background: color-mix(in oklab, var(--good) 25%, transparent);
  }

  .link {
    font: inherit;
    background: none;
    border: none;
    padding: 0.4rem 0 0;
    color: var(--series-1);
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .side {
    display: grid;
    gap: 0.7rem;
    align-content: start;
    min-height: 9.5rem; /* room for the answer and the rule, so nothing below moves */
  }

  @media (max-width: 720px) {
    .side {
      min-height: 12rem; /* the same text wraps onto more lines on a phone */
    }
  }

  .placeholder {
    margin: 0;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    padding-top: 0.6rem;
    border-top: 1px solid var(--axis);
  }

  .puzzle button:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  .eyebrow {
    margin: 0;
  }

  .btn {
    font: inherit;
    font-weight: 600;
    border-radius: 8px;
    padding: 0.55rem 1rem;
    cursor: pointer;
    border: 1px solid var(--series-1);
    background: none;
    color: var(--series-1);
    transition: background 0.15s, color 0.15s, opacity 0.15s;
  }

  .btn.primary {
    background: var(--series-1);
    color: #fff;
  }

  .btn.ghost {
    border-color: var(--axis);
    color: var(--ink);
  }

  .btn:focus-visible,
  .link:focus-visible {
    outline: 2px solid var(--series-1);
    outline-offset: 2px;
  }

  .btn:not(:disabled):hover {
    filter: brightness(1.06);
  }

  /* the next puzzle sits apart, on the right */
  .btn.next {
    margin-left: auto;
  }

  .all {
    border-top: 1px solid var(--axis);
    padding-top: 0.6rem;
  }

  .pager {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.4rem;
  }

  .small-btn {
    padding: 0.25rem 0.7rem;
  }

  .all-rows {
    width: 24.5rem;
    font-size: 1rem;
  }

  .verdict {
    margin: 0;
  }

  .rule {
    margin: 0;
  }

  .rule code {
    font-size: 1.1rem;
    white-space: normal;
    overflow-wrap: anywhere;
  }

  .rule-box p {
    margin: 0 0 0.4rem;
  }
</style>
