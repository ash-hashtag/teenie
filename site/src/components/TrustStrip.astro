---
// Where the model puts its trust: 0 = only the low-bit-first pass, 1 = only the high-bit-first pass.
interface Props {
  rows: { name: string; value: number; note?: string }[];
}

const { rows } = Astro.props;
const W = 720;
const label = 110;
const right = 16;
const rowH = 26;
const H = 30 + rows.length * rowH;
const sx = (v: number) => label + v * (W - label - right);
---

<svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Weight on the high-bit-first pass per relation">
  <text x={sx(0)} y="14" class="end">← low bit first</text>
  <text x={sx(1)} y="14" text-anchor="end" class="end">high bit first →</text>
  <line x1={sx(0.5)} x2={sx(0.5)} y1="22" y2={H} class="mid" />
  {
    rows.map((r, i) => {
      const cy = 30 + i * rowH + rowH / 2;
      return (
        <g data-tip={`${r.name}\nweight on high-bit-first pass: ${(r.value * 100).toFixed(0)}%${r.note ? `\n${r.note}` : ''}`}>
          <rect x="0" y={cy - rowH / 2} width={W} height={rowH} fill="transparent" />
          <text x={label - 10} y={cy + 4} text-anchor="end" class="name">
            {r.name}
          </text>
          <line x1={sx(0)} x2={sx(1)} y1={cy} y2={cy} class="track" />
          <circle cx={sx(r.value)} cy={cy} r="6" fill="var(--series-1)" stroke="var(--surface)" stroke-width="2" />
        </g>
      );
    })
  }
</svg>

<style>
  svg {
    width: 100%;
    height: auto;
    display: block;
    overflow: visible;
  }

  .track {
    stroke: var(--grid);
    stroke-width: 2;
  }

  .mid {
    stroke: var(--axis);
  }

  .name {
    fill: var(--ink-2);
    font-size: 13px;
    font-family: var(--mono);
  }

  .end {
    fill: var(--muted);
    font-size: 12px;
  }
</style>
