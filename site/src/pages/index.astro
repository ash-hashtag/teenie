---
import Layout from '../layouts/Layout.astro';
import BitStrip from '../components/BitStrip.astro';
import rounds from '../../public/data/rounds.json';
import { progress } from '../lib/data';
import { pct, thousands } from '../lib/format';

type Trace = {
  relation: string;
  context: number[][];
  examples: { a: number; b: number; target: number; prediction: number; rounds: { p: number[] }[] }[];
};
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const product = (rounds as Trace[]).find((t) => t.relation === 'a*b')!;
const rows = product.context.slice(0, 4) as [number, number, number][];
const question = product.examples[0]!;
const guesses = question.rounds.map((r) => r.p);
const wide = progress.wide;
const w16 = wide.widths['16']!;
const w32 = wide.widths['32']!;
// Rows of the "where it stands" table: model exact vs the best of five lookup baselines on the same episodes.
const table: { name: string; note: string; get: (w: typeof w32) => [number | null | undefined, number | null | undefined] }[] = [
  { name: 'Sealed set', note: '24 everyday functions written separately, never used to choose anything',
    get: (w) => [w.sealed?.exact, w.sealed_lookup] },
  { name: 'a>b ? a−b : a+b', note: 'conditionals were never in training',
    get: (w) => [w.families['a>b?a-b:a+b'], w.lookup['a>b?a-b:a+b']] },
  { name: 'rotl(a, b&7)', note: 'rotations were never in training',
    get: (w) => [w.families['rotl(a,b&7)'], w.lookup['rotl(a,b&7)']] },
  { name: 'T1 · 2 operations', note: 'random, always with an operation pair held out of training',
    get: (w) => [w.families['T1 2 ops'], w.lookup['T1 2 ops']] },
  { name: 'T2 · 3–4 operations', note: 'same, longer',
    get: (w) => [w.families['T2 3-4 ops'], w.lookup['T2 3-4 ops']] },
  { name: 'T3 · 5–7 operations', note: 'same, longer',
    get: (w) => [w.families['T3 5-7 ops'], w.lookup['T3 5-7 ops']] },
  { name: 'T6 · 4–6 operations, all concepts', note: 'includes division, comparisons, variable shifts, bit counts',
    get: (w) => [w.families['T6 4-6 ops, all concepts'], w.lookup['T6 4-6 ops, all concepts']] },
  { name: 'a*b+b', note: 'a product, then one more step',
    get: (w) => [w.families['a*b+b'], w.lookup['a*b+b']] },
  { name: '((a*b)^(a>>3))|(b+9)', note: 'the target: an unseen multi-step expression',
    get: (w) => [w.families['((a*b)^(a>>3))|(b+9)'], w.lookup['((a*b)^(a>>3))|(b+9)']] },
];
const conditional = w32.families['a>b?a-b:a+b'];
---

<Layout
  title="Teenie"
  description="A research model that reads 999 examples of a hidden relation on 16- and 32-bit integers and predicts the answer to a new question. Results next to lookup baselines, failures included."
>
  <section class="hero">
    <p class="eyebrow">Teenie · a research experiment</p>
    <h1>Can a small model infer a hidden rule from 999 examples?</h1>
    <p class="lede">
      Each episode is 999 examples <code>(a, b, c)</code> of a hidden relation on 16- or 32-bit integers — a random
      expression, a conditional, a loop — and one new <code>(a, b)</code>. The model is never told the relation and its
      weights never change while answering: in one forward pass it has to guess the rule from the examples and give
      <strong>every bit</strong> of <code>c</code>. At 32 bits a lucky guess is one in four billion, so every right
      answer has to come from the examples. It works on some kinds of relations and fails on others; both are below.
    </p>
  </section>

  <section class="stats grid-3">
    <div class="card stat">
      <span class="label">Model size</span>
      <span class="value">{wide.parameters ? `${Math.round(wide.parameters / 1000)}K` : '—'}</span>
      <span class="note">{wide.parameters ? `${thousands(wide.parameters)} parameters, the same at every width up to 32 bits` : ''}</span>
    </div>
    <div class="card stat">
      <span class="label">An unseen conditional at 32 bits</span>
      <span class="value">{pct(conditional)}</span>
      <span class="note">{`exact on a>b ? a−b : a+b, never trained; lookup gets ${pct(w32.lookup['a>b?a-b:a+b'])}`}</span>
    </div>
    <div class="card stat">
      <span class="label">A product, then one more step, at 32 bits</span>
      <span class="value">{pct(w32.families['a*b+b'])}</span>
      <span class="note">a*b+b — the clearest failure so far (see below)</span>
    </div>
  </section>

  <h2>Where it stands</h2>
  <p>
    The width-free model at 16 and 32 bits. Every method answers the same questions (64 episodes × 16 questions per
    relation, never used in training). <b>Lookup</b> is the best of five methods that understand nothing: copy the
    answer of the closest example, or match one or two neighbouring bits across the examples — chosen per relation
    after the fact, so it is a generous reference. A score only means something where it clearly beats lookup.
  </p>
  <div class="scroll">
    <table>
      <thead>
        <tr>
          <th>relation</th>
          <th class="num">16 bits</th>
          <th class="num">lookup</th>
          <th class="num">32 bits</th>
          <th class="num">lookup</th>
        </tr>
      </thead>
      <tbody>
        {
          table.map((row) => {
            const [m16, l16] = row.get(w16);
            const [m32, l32] = row.get(w32);
            return (
              <tr>
                <td>
                  <code>{row.name}</code> <span class="small muted">{row.note}</span>
                </td>
                <td class="num"><b>{pct(m16)}</b></td>
                <td class="num muted">{pct(l16)}</td>
                <td class="num"><b>{pct(m32)}</b></td>
                <td class="num muted">{pct(l32)}</td>
              </tr>
            );
          })
        }
      </tbody>
    </table>
  </div>
  <p class="small muted">
    {`Sure answers (least certain bit ≥ 0.99) were right ${pct(w32.sealed?.sure_accuracy)} of the time on the sealed set at 32 bits. One training seed; differences of a few points are within seed-to-seed spread.`}
  </p>

  <h2>Multi-step chains</h2>
  <p>
    Chains are a start such as <code>a+b</code> or <code>a*b</code> followed by one or two steps, each one of 21 kinds
    (<code>+ − ^ | &amp; *</code> with <code>a</code>, <code>b</code> or a random constant, shifts, not), with a fresh
    random constant each time. This model was trained on random expressions over the same operations, which can
    include the same shapes with other constants, so these are new relations but not necessarily new shapes; products
    followed by a step were in its training too. <b>Beyond lookup</b> counts
    only the questions every lookup method gets wrong; <b>sure</b> is how often its least certain bit is ≥ 0.99, and how
    often those sure answers were right.
  </p>
  <div class="scroll">
    <table>
      <thead>
        <tr>
          <th>chains</th>
          <th class="num">16 bits</th>
          <th class="num">beyond lookup</th>
          <th class="num">32 bits</th>
          <th class="num">beyond lookup</th>
          <th class="num">sure at 32 · right</th>
        </tr>
      </thead>
      <tbody>
        {
          ['no product 1 step', 'no product 2 steps', 'product 1 step', 'product 2 steps'].map((kind) => {
            const a = w16.chains?.[kind];
            const b = w32.chains?.[kind];
            return (
              <tr>
                <td>{kind.replace('no product', 'without a product').replace(/^product/, 'through a product')}</td>
                <td class="num"><b>{pct(a?.exact)}</b></td>
                <td class="num muted">{pct(a?.beyond_lookup)}</td>
                <td class="num"><b>{pct(b?.exact)}</b></td>
                <td class="num muted">{pct(b?.beyond_lookup)}</td>
                <td class="num">{`${pct(b?.sure_coverage)} · ${b?.sure_accuracy == null ? '—' : pct(b.sure_accuracy)}`}</td>
              </tr>
            );
          })
        }
      </tbody>
    </table>
  </div>
  <p class="small muted">48 episodes × 16 questions per kind; <code>uv run python -m teenie.bits.chain_split</code>.</p>

  <h2>Learning to compute through a product</h2>
  <p>
    Chains through a product at 16 bits, on start–step pairs held out of all chain training, as training went on. Without a
    rule to compute, the model matches examples on the input bits that matter; a product's high bits depend on so many
    input bits that 999 examples run out of matches around bit 5. Getting further needs the model to compute through
    the product — scratch registers, numbers it writes and reads back every round, were the first change that did.
  </p>
  <div class="scroll">
    <table>
      <thead>
        <tr>
          <th>stage</th>
          <th class="num">through a product, 1 step</th>
          <th class="num">2 steps</th>
          <th class="num">sure on 1 step · right</th>
        </tr>
      </thead>
      <tbody>
        {
          progress.products.map((row) => {
            const one = row.summary['product 1 step'];
            const two = row.summary['product 2 steps'];
            return (
              <tr>
                <td>{row.stage}</td>
                <td class="num"><b>{pct(one?.exact)}</b></td>
                <td class="num"><b>{pct(two?.exact)}</b></td>
                <td class="num">{one?.sure_coverage == null ? '—' : `${pct(one.sure_coverage)} · ${one.sure_accuracy == null ? '—' : pct(one.sure_accuracy)}`}</td>
              </tr>
            );
          })
        }
      </tbody>
    </table>
  </div>
  <p class="small muted">At 32 bits these are still at zero: training so far is at 16 bits only.</p>

  <h2>What works and what doesn't</h2>
  <div class="grid-3">
    <div class="card">
      <h3>Works: combining steps it knows</h3>
      <p class="small">
        Chains of additions, subtractions, bitwise operations, shifts and constants, and conditionals it never trained
        on — at 32 bits, mostly on questions lookup cannot answer, and its sure answers are right.
      </p>
    </div>
    <div class="card">
      <h3>Partly: anything through a product</h3>
      <p class="small">
        The model computes <code>a*b</code> itself, but a product followed by another step is hard: at 16 bits a third
        of one-step product chains are now right, and it is sure of some of them and right when sure; at 32 bits they,
        <code>a*b+b</code> and the target expression are still at zero, and it is never sure of them.
      </p>
    </div>
    <div class="card">
      <h3>Honest about it</h3>
      <p class="small">
        Its confidence is the certainty of its least certain bit. On relations it cannot work out it is rarely sure,
        so its sure answers stay right almost every time even where its overall score is low.
      </p>
    </div>
  </div>

  <h2>How it answers</h2>
  <section class="demo card" id="demo" data-guesses={JSON.stringify(guesses)} aria-label="An 8-bit model answering a multiplication question, round by round">
    <div class="demo-grid">
      <div>
        <p class="eyebrow">999 examples (4 shown) · relation hidden</p>
        <div class="rows">
          {
            rows.map(([a, b, c]) => (
              <div class="ex">
                <BitStrip value={a} />
                <span class="op">?</span>
                <BitStrip value={b} />
                <span class="op">→</span>
                <BitStrip value={c} />
              </div>
            ))
          }
          <div class="ex dots">⋮ 995 more</div>
        </div>
      </div>
      <div>
        <p class="eyebrow">New question · <span data-role="round">round 1 of {guesses.length}</span></p>
        <div class="ex">
          <BitStrip value={question.a} />
          <span class="op">?</span>
          <BitStrip value={question.b} />
          <span class="op">→</span>
          <div class="answer">
            <BitStrip value={0} probs={guesses[0]} />
          </div>
        </div>
        <p class="small muted note">
          A recording from the earlier 8-bit model, small enough to show: it guesses every bit at once and corrects the
          guess each round by reading the examples again. Here the hidden relation is <code>a*b</code>:
          {` ${question.a} × ${question.b} = ${question.target} (mod 256).`} Blue = surely 1, pale = surely 0. 8-bit results
          are not used to judge the model: with only 256 possible answers and examples covering 1.5% of all inputs,
          lookup alone does well there.
        </p>
      </div>
    </div>
  </section>

  <h2>Read more</h2>
  <div class="grid-3 links">
    <a class="card link" href={`${base}/model/`}>
      <p class="eyebrow">Model</p>
      <h3>The bit-token design</h3>
      <p>One token per answer bit, refined over rounds; the architecture and where its parameters are.</p>
    </a>
    <a class="card link" href={`${base}/results/`}>
      <p class="eyebrow">Results</p>
      <h3>Every run on the test tiers</h3>
      <p>Unseen expressions, new operation types and loops, run by run.</p>
    </a>
    <a class="card link" href={`${base}/changelog/`}>
      <p class="eyebrow">Changelog</p>
      <h3>How it got here</h3>
      <p>Every experiment, including the ones that did not work.</p>
    </a>
  </div>
</Layout>

<script>
  // Replay the recorded guesses: all 8 bits update together, round after round.
  const demo = document.getElementById('demo');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (demo) {
    const guesses = JSON.parse(demo.dataset.guesses ?? '[]') as number[][];
    const cells = Array.from(demo.querySelectorAll<HTMLElement>('.answer .cell'));
    const label = demo.querySelector('[data-role="round"]')!;
    const show = (t: number) => {
      const p = guesses[t]!;
      cells.forEach((c, i) => c.style.setProperty('--p', String(p[7 - i])));
      label.textContent = `round ${t + 1} of ${guesses.length}`;
    };
    if (reduce) show(guesses.length - 1);
    else {
      let step = 0;
      show(0);
      window.setInterval(() => {
        step = (step + 1) % (guesses.length + 3); // hold the final answer for a moment
        show(Math.min(step, guesses.length - 1));
      }, 700);
    }
  }
</script>

<style>
  .hero {
    margin-bottom: 2rem;
  }

  .demo-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 400px), 1fr));
    gap: 1.5rem;
  }

  .rows {
    display: grid;
    gap: 0.35rem;
  }

  .ex {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    flex-wrap: nowrap;
    overflow-x: auto;
  }

  .ex :global(.strip .dec) {
    display: none;
  }

  .ex :global(.strip .cells) {
    gap: 2px;
  }

  .ex :global(.strip .cell) {
    width: 13px;
    height: 20px;
    font-size: 0.7rem;
    border-radius: 3px;
  }

  .answer :global(.strip .cell) {
    transition: background 0.35s;
  }

  .op {
    color: var(--muted);
    font-family: var(--mono);
  }

  .dots {
    color: var(--muted);
    font-size: 0.85rem;
    padding-left: 0.25rem;
  }

  .note {
    margin-top: 1rem;
  }

  .scroll {
    overflow-x: auto;
  }

  .stats {
    margin-top: 1.5rem;
  }

  .link {
    color: inherit;
    text-decoration: none;
    transition: border-color 0.15s;
  }

  .link:hover {
    border-color: var(--series-1);
  }

  .link h3 {
    margin-top: 0;
    color: var(--ink);
  }

  .link p:last-child {
    margin-bottom: 0;
  }
</style>
