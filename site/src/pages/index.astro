---
import Layout from '../layouts/Layout.astro';
import BitStrip from '../components/BitStrip.astro';
import rounds from '../../public/data/rounds.json';
import { current, experimentById } from '../lib/data';
import { pct, thousands } from '../lib/format';

type Trace = {
  relation: string;
  context: number[][];
  examples: { a: number; b: number; target: number; prediction: number; rounds: { p: number[] }[] }[];
};
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const product = (rounds as Trace[]).find((t) => t.relation === 'a*b')!;
const rows = product.context.slice(0, 4) as [number, number, number][];
const question = product.examples[0]!;
const guesses = question.rounds.map((r) => r.p);
const arch = current.architecture;
const tiers = Object.keys(current.summary).filter((g) => g.startsWith('T'));
const won = tiers.filter((t) => current.summary[t]?.won).length;
const mix = experimentById('mix');
const named = ['add', 'sub', 'b-a', 'xor', 'and', 'or', 'a+2b', '2a+b', 'max', 'a<<1', 'a+const', 'b^const'];
const namedLow = Math.min(...named.map((n) => current.families[n] ?? 0));
---

<Layout title="Teenie" description="A small model that reads 999 examples of a hidden relation and answers new questions exactly.">
  <section class="hero">
    <p class="eyebrow">Teenie · relation inference from examples</p>
    <h1>Show it 999 examples. It works out the rule.</h1>
    <p class="lede">
      Each example is two 8-bit numbers <code>a</code>, <code>b</code> and an answer <code>c</code> from a hidden
      relation — addition, multiplication, a random expression, even a loop. The model is never told which. It reads the
      examples and must produce <strong>every bit</strong> of <code>c</code> for a new <code>(a, b)</code>; close
      doesn't count.
    </p>
  </section>

  <section class="demo card" id="demo" data-guesses={JSON.stringify(guesses)} aria-label="The current model answering a multiplication question, round by round">
    <div class="demo-grid">
      <div>
        <p class="eyebrow">999 examples (4 shown) · relation hidden</p>
        <div class="rows">
          {
            rows.map(([a, b, c]) => (
              <div class="ex">
                <BitStrip value={a} />
                <span class="op">?</span>
                <BitStrip value={b} />
                <span class="op">→</span>
                <BitStrip value={c} />
              </div>
            ))
          }
          <div class="ex dots">⋮ 995 more</div>
        </div>
      </div>
      <div>
        <p class="eyebrow">New question · <span data-role="round">round 1 of {guesses.length}</span></p>
        <div class="ex">
          <BitStrip value={question.a} />
          <span class="op">?</span>
          <BitStrip value={question.b} />
          <span class="op">→</span>
          <div class="answer">
            <BitStrip value={0} probs={guesses[0]} />
          </div>
        </div>
        <p class="small muted note">
          The real model, recorded. It guesses all 8 bits at once and corrects the guess every round by looking back at the
          examples. Here the hidden relation is <code>a*b</code>: {`${question.a} × ${question.b} = ${question.target} (mod 256).`}
          Blue = surely 1, pale = surely 0.
        </p>
      </div>
    </div>
  </section>

  <section class="stats grid-3">
    <div class="card stat">
      <span class="label">Model size</span>
      <span class="value">{Math.round(arch.parameters / 1000)}K</span>
      <span class="note">
        {thousands(arch.parameters)} parameters · {arch.layers} look layers × {arch.rounds} rounds · width {arch.hidden}
      </span>
    </div>
    <div class="card stat">
      <span class="label">8-bit multiplication, current model</span>
      <span class="value">{pct(current.families['a*b'])}</span>
      <span class="note"
        >{`An earlier run with fewer relation kinds reached ${pct(mix?.families['a*b']?.exact)}; now more kinds share the same training budget. The first models: under 7%.`}</span
      >
    </div>
    <div class="card stat">
      <span class="label">Difficulty tiers won</span>
      <span class="value">{won} of {tiers.length}</span>
      <span class="note">≥50% exact on unseen relations with honest confidence</span>
    </div>
  </section>

  <h2>What it does</h2>
  <div class="grid-3">
    <div class="card">
      <h3>Finds the rule</h3>
      <p class="small">
        {`Every named relation it trained on is ${pct(namedLow)}–100% exact, and it multiplies 8-bit numbers — without an operation name, a formula menu or any retraining at answer time.`}
      </p>
    </div>
    <div class="card">
      <h3>Handles the unseen</h3>
      <p class="small">
        {`Combinations it was never shown average ${pct(current.summary.hidden?.exact)}; new operation types like division and conditionals ${pct(current.summary.T4?.exact)}. Copying the closest example gets about 9%.`}
      </p>
    </div>
    <div class="card">
      <h3>Knows when it knows</h3>
      <p class="small">
        {`Confidence is the certainty of its least certain bit. On unseen relations its sure answers were right ${pct(current.summary.hidden?.sure_accuracy)} of the time — and it rarely claims to be sure when it isn't.`}
      </p>
    </div>
  </div>

  <h2>Read more</h2>
  <div class="grid-3 links">
    <a class="card link" href={`${base}/model/`}>
      <p class="eyebrow">Model</p>
      <h3>How it reasons</h3>
      <p>The architecture, where its {thousands(arch.parameters)} parameters are, and a replay of it thinking round by round.</p>
    </a>
    <a class="card link" href={`${base}/results/`}>
      <p class="eyebrow">Results</p>
      <h3>The difficulty ladder</h3>
      <p>Unseen expressions, new operation types and loops — scored against a 50% bar.</p>
    </a>
    <a class="card link" href={`${base}/changelog/`}>
      <p class="eyebrow">Changelog</p>
      <h3>How it got here</h3>
      <p>Every experiment, from decimal regression to the first bit-by-bit model to multiplication and loops.</p>
    </a>
  </div>
</Layout>

<script>
  // Replay the recorded guesses: all 8 bits update together, round after round.
  const demo = document.getElementById('demo');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (demo) {
    const guesses = JSON.parse(demo.dataset.guesses ?? '[]') as number[][];
    const cells = Array.from(demo.querySelectorAll<HTMLElement>('.answer .cell'));
    const label = demo.querySelector('[data-role="round"]')!;
    const show = (t: number) => {
      const p = guesses[t]!;
      cells.forEach((c, i) => c.style.setProperty('--p', String(p[7 - i])));
      label.textContent = `round ${t + 1} of ${guesses.length}`;
    };
    if (reduce) show(guesses.length - 1);
    else {
      let step = 0;
      show(0);
      window.setInterval(() => {
        step = (step + 1) % (guesses.length + 3); // hold the final answer for a moment
        show(Math.min(step, guesses.length - 1));
      }, 700);
    }
  }
</script>

<style>
  .hero {
    margin-bottom: 2rem;
  }

  .demo-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 400px), 1fr));
    gap: 1.5rem;
  }

  .rows {
    display: grid;
    gap: 0.35rem;
  }

  .ex {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    flex-wrap: nowrap;
    overflow-x: auto;
  }

  .ex :global(.strip .dec) {
    display: none;
  }

  .ex :global(.strip .cells) {
    gap: 2px;
  }

  .ex :global(.strip .cell) {
    width: 13px;
    height: 20px;
    font-size: 0.7rem;
    border-radius: 3px;
  }

  .answer :global(.strip .cell) {
    transition: background 0.35s;
  }

  .op {
    color: var(--muted);
    font-family: var(--mono);
  }

  .dots {
    color: var(--muted);
    font-size: 0.85rem;
    padding-left: 0.25rem;
  }

  .note {
    margin-top: 1rem;
  }

  .stats {
    margin-top: 1.5rem;
  }

  .link {
    color: inherit;
    text-decoration: none;
    transition: border-color 0.15s;
  }

  .link:hover {
    border-color: var(--series-1);
  }

  .link h3 {
    margin-top: 0;
    color: var(--ink);
  }

  .link p:last-child {
    margin-bottom: 0;
  }
</style>
