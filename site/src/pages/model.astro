---
import Layout from '../layouts/Layout.astro';
import BitTokenDiagram from '../components/BitTokenDiagram.astro';
import RoundsInspector from '../components/RoundsInspector.astro';
import { progress } from '../lib/data';
import { thousands } from '../lib/format';

const model = progress.current!;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const share = (n: number) => `${((100 * n) / model.parameters).toFixed(1)}%`;
---

<Layout
  title="Model"
  description="The current model: width-free bit tokens that read 999 examples bit by bit, refine every answer bit over rounds, keep scratch registers and check worked examples — one set of weights for 16- and 32-bit numbers."
>
  <p class="eyebrow">Model</p>
  <h1>The current model</h1>
  <p class="lede">
    It is never told which relation it faces and its weights never change while answering. It reads the 999 examples,
    then <strong>guesses every bit of the answer and corrects the guess</strong>, round after round, with the same
    weights — and nothing in it depends on the width, so one set of weights answers 16- and 32-bit questions.
  </p>

  <div class="grid-3 stats">
    <div class="card stat">
      <span class="label">Parameters</span>
      <span class="value">{thousands(model.parameters)}</span>
      <span class="note">the same at every width up to {model.span} bits</span>
    </div>
    <div class="card stat">
      <span class="label">Bit layers · rounds</span>
      <span class="value">{model.layers} · {model.rounds}</span>
      <span class="note">{`width ${model.hidden}, ${model.heads} attention heads, the same weights every round`}</span>
    </div>
    <div class="card stat">
      <span class="label">Scratch registers · worked examples</span>
      <span class="value">{model.registers} · {model.worked_examples}</span>
      <span class="note">room for intermediate values, and examples worked through like questions</span>
    </div>
  </div>

  <h2>How it answers</h2>
  <div class="card">
    <BitTokenDiagram layers={model.layers} rounds={model.rounds} heads={model.heads} />
  </div>
  <div class="grid-2 steps">
    <div>
      <p class="eyebrow">1 · See every bit from where it sits</p>
      <p>
        Each bit of every example — and of the question — is a token that sees the numbers relative to its own position
        (31 bits either side) and counted from the lowest bit. No layer is sized for a width, so the same weights read
        8, 16 or 32 bits.
      </p>
    </div>
    <div>
      <p class="eyebrow">2 · One token per answer bit</p>
      <p>
        The question holds one token per answer bit. Each round the answer bits attend to each other — so carries and
        partial products can move between positions — and each reads the same bit of all 999 examples.
      </p>
    </div>
    <div>
      <p class="eyebrow">3 · Scratch registers and worked examples</p>
      <p>
        {`Besides its guess, every question keeps ${model.registers} scratch numbers it writes and reads back each round, and ${model.worked_examples} examples are worked through the same way, so the answer bits can read what was worked out for real examples next to their true answers.`}
        This was the first change that let it compute through a product instead of matching examples.
      </p>
    </div>
    <div>
      <p class="eyebrow">4 · Answer, and say how sure</p>
      <p>
        After the last round each answer bit is read out as a probability. The answer is the most likely bit at each
        position; its confidence is that of its least certain bit, and only answers with every bit at least 0.99 count
        as sure.
      </p>
    </div>
  </div>

  <h2>Where the parameters are</h2>
  <div class="table-scroll">
    <table>
      <thead>
        <tr>
          <th>part</th>
          <th>what it does</th>
          <th class="num">parameters</th>
          <th class="num">share</th>
        </tr>
      </thead>
      <tbody>
        {
          model.parts.map((p) => (
            <tr>
              <td>
                <b>{p.part}</b>
              </td>
              <td class="muted">{p.detail}</td>
              <td class="num">{thousands(p.parameters)}</td>
              <td class="num">{share(p.parameters)}</td>
            </tr>
          ))
        }
        <tr>
          <td><b>Total</b></td>
          <td></td>
          <td class="num"><b>{thousands(model.parameters)}</b></td>
          <td class="num">100%</td>
        </tr>
      </tbody>
    </table>
  </div>
  <p class="small muted">
    {`Checkpoint ${model.checkpoint}, update ${model.update}; source src/teenie/bits/wide_model.py. How it got here — every design tried, including the ones that did not work — is in the `}<a
      href={`${base}/changelog/`}>changelog</a
    > and the <a href={`${base}/findings/`}>findings</a>.
  </p>

  <h2>Watch an earlier model answer</h2>
  <p>
    A recording from the earlier 8-bit version of the same design, small enough to step through: the guess starts
    undecided and sharpens round by round as the answer bits keep looking back at the examples. 8-bit results are not
    used to judge the model — there, lookup alone does well.
  </p>
  <RoundsInspector />
</Layout>

<style>
  .stats {
    margin-top: 1.5rem;
  }

  .steps {
    margin-top: 1rem;
  }

  .steps p:last-child {
    margin-bottom: 0;
  }
</style>
