---
import Layout from '../layouts/Layout.astro';
import info from '../../public/weights/teenie.json';
import { KINDS } from '../lib/rulegen';

// Rules it handles well (ordinary ones, then ones with no textbook solution from the held-out middle band), then rules
// it is known to be weak at, so visitors see both.
const presets = [
  { label: 'a + b', formula: 'a + b' },
  { label: 'a * b', formula: 'a * b' },
  { label: '(a*b)+a', formula: 'a * b + a' },
  { label: 'max − min', formula: 'max(a, b) - min(a, b)' },
  { label: '3·(a xor b)', formula: '(a ^ b) * 3' },
  { label: 'deep, with a constant', formula: '(((a ^ 0x5A5A5A5A) + b) >> 1) ^ (a & b)' },
  { label: 'bit-select', formula: 'a + b if (a >> (b & 15)) & 1 else a ^ (b << 1)' },
  { label: 'max of mixed', formula: 'max(a * 3, b ^ a) - min(a, b) * 2' },
  { label: 'the target', formula: '((a * b) ^ (a >> 3)) | (b + 9)' },
];
const weak = [
  { label: 'product of computed values', formula: '(a + b) * a' },
  { label: 'difference of squares', formula: 'a * a - b * b' },
  { label: 'rotation', formula: 'rotl(a, 7) ^ b' },
];
const parameters = info.parameters.toLocaleString('en-US');
const CHUNK = 128; // questions per pass for an uploaded file (also in the script below)
---

<Layout
  title="Try it: infer a hidden rule in your browser"
  description="Type any integer function of a and b. Your browser generates 999 examples, and a 1.1M-parameter model infers the rule and answers new 32-bit questions in one pass, entirely on your device."
  keywords={['interactive demo', 'in-browser inference', 'onnx runtime web', 'webassembly']}
  kind="website"
>
  <p class="eyebrow">Try it</p>
  <h1>Give it a rule it has never seen</h1>
  <p class="lede">
    Type a function of <code>a</code> and <code>b</code>. Your browser draws 999 examples of it plus 16 new questions,
    and the model, which never sees your formula, reads the examples and answers every bit of every question in one
    pass. It also says how sure it is of each bit. Everything runs on your device; the {parameters}-parameter model
    is a download of about 8 MB. You can also <a href="#csv">upload your own data</a> as a CSV file and download its
    answers.
  </p>

  <p class="status small" data-role="status" data-files={JSON.stringify(Object.fromEntries(Object.entries(info.widths).map(([w, f]) => [w, f.file])))} data-checks={JSON.stringify(Object.fromEntries(Object.entries(info.widths).map(([w, f]) => [w, f.check])))}>Loading the model…</p>
  <p class="backend small" data-role="backend" aria-live="polite"></p>

  <section class="card form">
    <label for="formula" class="eyebrow">The hidden rule</label>
    <div class="row">
      <span class="prefix">c =</span>
      <input id="formula" type="text" value="a * b + a" spellcheck="false" autocomplete="off" />
    </div>
    <div class="chips">
      {presets.map((p) => <button class="chip" type="button" data-formula={p.formula} title={p.formula}>{p.label}</button>)}
    </div>
    <div class="chips weak">
      <span class="small muted">Known weak spots:</span>
      {weak.map((p) => <button class="chip" type="button" data-formula={p.formula} title={p.formula}>{p.label}</button>)}
    </div>
    <div class="generated">
      <div class="generated-head">
        <span class="small muted">Random rules, made up in your browser:</span>
        <button class="chip kind active" type="button" data-kind="all">All kinds</button>
        {KINDS.map((k) => <button class="chip kind" type="button" data-kind={k.kind}>{k.label}</button>)}
        <button class="again" type="button" data-role="again">↻ New rules</button>
      </div>
      <ol class="rule-list" data-role="generated"></ol>
    </div>
    <p class="small muted weak-note">
      It can multiply <code>a</code> by <code>b</code>, but not values it has to compute first, such as
      <code>(a + b) * a</code>, where it gets the lowest few bits and guesses the rest. Rotations are new to it as well.
    </p>
    <div class="options">
      <label class="small">Numbers of
        <select data-role="width">
          <option value="32" selected>32 bits</option>
          <option value="16">16 bits</option>
        </select>
      </label>
      <label class="small"><input type="checkbox" data-role="small" /> small numbers (a, b under 256)</label>
      <button class="primary" type="button" data-role="run" disabled>Ask 16 questions</button>
    </div>
    <details class="own" data-role="own-box">
      <summary class="small">Ask your own questions too</summary>
      <label for="own" class="small muted">
        One <code>a, b</code> per line, decimal or <code>0x…</code>, up to 16. Random questions fill up the rest of the
        16, and yours never appear among the 999 examples.
      </label>
      <textarea id="own" rows="3" spellcheck="false" placeholder="12, 34&#10;1000000, 0xdeadbeef"></textarea>
    </details>
    <div class="progress" data-role="progress" hidden>
      <div class="track"><div class="fill" data-role="fill"></div></div>
      <span class="small muted" data-role="progress-label"></span>
    </div>
    <details class="small muted help">
      <summary>What you can write</summary>
      <p>
        Python-style: <code>+ - * // % **</code>, <code>&amp; | ^ ~ &lt;&lt; &gt;&gt;</code>, comparisons (1 or 0),
        <code>not and or</code>, <code>x if cond else y</code> or <code>cond ? x : y</code>, and
        <code>min max popcount reverse rotl rotr</code>, and three kinds of loop: <code>sum(f for i in range(n))</code>
        adds up <code>f</code> for <code>i</code> from 0 to <code>n − 1</code>; <code>loop(n, start, f)</code> starts with
        <code>x = start</code> and sets <code>x = f</code> n times; <code>rec(n, x0, y0, f)</code> starts with
        <code>x, y = x0, y0</code> and sets <code>x, y = f, x</code> n times (the answer is <code>x</code>). Inside a loop,
        <code>i</code> is the step number. A loop runs at most 255 times and loops can't be nested. Numbers are unsigned and wrap at the width after every step,
        as in training, and division by zero gives all ones. Don't expect much on rules built to scramble bits, like
        hashes or ciphers.
      </p>
    </details>
    <p class="error small" data-role="error" hidden></p>
  </section>

  <section class="card result" data-role="result" hidden>
    <div class="grid-4 tiles">
      <div class="stat">
        <span class="label">Exactly right</span>
        <span class="value" data-role="exact">—</span>
      </div>
      <div class="stat">
        <span class="label">Bits right</span>
        <span class="value" data-role="bits">—</span>
      </div>
      <div class="stat">
        <span class="label">Bits recovered (of <span data-role="w">32</span>)</span>
        <span class="value" data-role="recovered">—</span>
        <span class="note" data-role="times"></span>
      </div>
      <div class="stat">
        <span class="label">Sure of every bit · right when sure</span>
        <span class="value" data-role="sure">—</span>
      </div>
    </div>
    <p class="small muted" data-role="note"></p>
    <div class="table-wrap">
      <table>
        <thead>
          <tr><th class="num">a</th><th class="num">b</th><th class="num">true c</th><th class="num">its answer</th><th>each bit, high → low (dark 1, light 0, in between unsure)</th><th class="num">bits recovered</th></tr>
        </thead>
        <tbody data-role="rows"></tbody>
      </table>
    </div>
    <details class="small">
      <summary>All 999 examples it read</summary>
      <div class="pager">
        <button type="button" class="chip" data-role="page-prev">← Previous</button>
        <span class="small muted" data-role="page-label"></span>
        <button type="button" class="chip" data-role="page-next">Next →</button>
      </div>
      <table class="examples">
        <thead><tr><th class="num">#</th><th class="num">a</th><th class="num">b</th><th class="num">c</th></tr></thead>
        <tbody data-role="examples"></tbody>
      </table>
    </details>
    <p class="small muted">
      <strong>Bits recovered</strong> is the width plus log<sub>2</sub> of the probability the model gave the true
      answer. A blind guess scores 0 and certain-and-right scores the full width, while a confident mistake drags the
      score down. Addition gets the full width; a hash gets about 0.
    </p>
  </section>

  <h2 id="csv">Use your own data</h2>
  <section class="card form csv">
    <p class="small">
      Upload a CSV file with columns <code>a, b, c</code>. The first 999 rows are the examples it reads; every row after
      them is a question for it to answer. Leave <code>c</code> empty on the question rows, or fill it in to see how often
      it gets them right. Numbers are whole and unsigned, decimal or <code>0x…</code>, below 2<sup>32</sup>. The file
      never leaves your device.
    </p>
    <div class="options">
      <label class="file chip">Choose a CSV file<input type="file" accept=".csv,.tsv,.txt,text/csv" data-role="csv-file" /></label>
      <button class="chip" type="button" data-role="csv-sample">Download an example file</button>
      <span class="small muted">(made from the rule above: 999 examples and 200 questions)</span>
    </div>
    <p class="small" data-role="csv-summary" hidden></p>
    <div class="options" data-role="csv-actions" hidden>
      <label class="small">Numbers of
        <select data-role="csv-width">
          <option value="16">16 bits</option>
          <option value="32">32 bits</option>
        </select>
      </label>
      <button class="primary" type="button" data-role="csv-run">Answer the questions</button>
      <button class="chip" type="button" data-role="csv-stop" hidden>Stop</button>
      <button class="chip" type="button" data-role="csv-download" hidden>Download the answers (CSV)</button>
    </div>
    <div class="progress" data-role="csv-progress" hidden>
      <div class="track"><div class="fill" data-role="csv-fill"></div></div>
      <span class="small muted" data-role="csv-progress-label"></span>
    </div>
    <p class="error small" data-role="csv-error" hidden></p>
    <div class="result csv-result" data-role="csv-result" hidden>
      <div class="grid-4 tiles" data-role="csv-tiles">
        <div class="stat">
          <span class="label">Questions answered</span>
          <span class="value" data-role="csv-answered">—</span>
          <span class="note" data-role="csv-speed"></span>
        </div>
        <div class="stat">
          <span class="label">Sure of every bit</span>
          <span class="value" data-role="csv-sure">—</span>
        </div>
        <div class="stat" data-role="csv-scored">
          <span class="label">Exactly right</span>
          <span class="value" data-role="csv-exact">—</span>
          <span class="note" data-role="csv-exact-note"></span>
        </div>
      </div>
      <div class="pager">
        <button type="button" class="chip" data-role="csv-prev">← Previous</button>
        <span class="small muted" data-role="csv-page"></span>
        <button type="button" class="chip" data-role="csv-next">Next →</button>
      </div>
      <div class="table-wrap">
        <table>
          <thead data-role="csv-head"></thead>
          <tbody data-role="csv-rows"></tbody>
        </table>
      </div>
      <p class="small muted">
        <strong>Confidence</strong> is the probability of its least certain bit; an answer counts as sure when every bit
        is at 0.99 or above. Questions are answered {CHUNK} at a time: each is answered on its own (the questions in a
        pass never see each other, so the answers are the same as asking one by one), but one pass reads the 999
        examples once for all of them, which is about 30 times faster.
      </p>
    </div>
  </section>
</Layout>

<script>
  import { evaluate, parse } from '../lib/expression';
  import { generate, KINDS, type Kind } from '../lib/rulegen';

  const CONTEXT = 999;
  const QUESTIONS = 16;
  const FLOOR = 2 ** -20;
  const BASE = import.meta.env.BASE_URL.replace(/\/$/, '');

  const $ = <T extends Element>(role: string) => document.querySelector<T>(`[data-role="${role}"]`)!;
  const input = document.getElementById('formula') as HTMLInputElement;
  const own = document.getElementById('own') as HTMLTextAreaElement;
  const widthSelect = $<HTMLSelectElement>('width');
  const runButton = $<HTMLButtonElement>('run');
  const worker = new Worker(new URL('../lib/infer.worker.ts', import.meta.url), { type: 'module' });
  // File names carry a content hash (export_web.py), so the browser and Cloudflare can cache them forever.
  const FILES = JSON.parse(document.querySelector<HTMLElement>('[data-files]')!.dataset.files!) as Record<string, string>;
  const modelUrl = (width: number) => `${BASE}/weights/${FILES[String(width)]}`;
  // Per width, a small fixed episode's expected output: the worker checks the GPU against it before trusting it.
  const CHECKS = JSON.parse(document.querySelector<HTMLElement>('[data-checks]')!.dataset.checks!) as Record<string, number[]>;
  const backends: Record<number, { backend: string; device: string }> = {};
  const where = (width: number) => (backends[width]?.backend === 'webgpu' ? 'GPU' : 'CPU');
  // What the model runs on, for the status line: the GPU through WebGPU, or the CPU through WebAssembly and why.
  function backendLine(width: number): string {
    const b = backends[width];
    if (!b) return '';
    return b.backend === 'webgpu'
      ? `<span class="chip gpu">GPU</span> Running on your GPU (WebGPU, ${escape(b.device)}).`
      : `<span class="chip cpu">CPU</span> Running on your CPU (WebAssembly). GPU not used: ${escape(b.device)}.`;
  }
  const escape = (text: string) => text.replace(/[&<>"]/g, (c) => `&#${c.charCodeAt(0)};`);
  const smallBox = $<HTMLInputElement>('small');

  // Seconds one pass took last time, per width: drives the estimated progress while the model thinks.
  const lastSeconds: Record<number, number> = { 16: 3, 32: 6 };
  const loaded = new Set<number>();
  let nextId = 0;
  const waiting = new Map<number, { resolve: (p: Float32Array, s: number) => void; reject: (e: Error) => void }>();
  let loadWaiters: { width: number; resolve: () => void; reject: (e: Error) => void }[] = [];

  worker.onmessage = (event: MessageEvent) => {
    const m = event.data;
    if (m.type === 'progress') {
      const mb = (n: number) => (n / 1e6).toFixed(1);
      const done = m.total > 0 && m.loaded >= m.total;
      showProgress(m.total ? m.loaded / m.total : 0, done ? 'Setting up (checking whether your GPU gives the right answers)…'
        : `Downloading the model: ${mb(m.loaded)}${m.total ? ` of ${mb(m.total)}` : ''} MB`);
    } else if (m.type === 'ready') {
      loaded.add(m.width);
      backends[m.width] = { backend: m.backend, device: m.device };
      console.info(`[teenie] ${m.width}-bit model ready on the ${where(m.width)}: ${m.device}`);
      $('backend').innerHTML = backendLine(m.width);
      loadWaiters.filter((w) => w.width === m.width).forEach((w) => w.resolve());
      loadWaiters = loadWaiters.filter((w) => w.width !== m.width);
    } else if (m.type === 'result') {
      waiting.get(m.id)?.resolve(m.probabilities, m.seconds);
      waiting.delete(m.id);
    } else if (m.type === 'error') {
      const error = new Error(m.message);
      if (m.id !== undefined && waiting.has(m.id)) {
        waiting.get(m.id)!.reject(error);
        waiting.delete(m.id);
      } else {
        loadWaiters.forEach((w) => w.reject(error));
        loadWaiters = [];
      }
    }
  };

  function load(width: number): Promise<void> {
    if (loaded.has(width)) return Promise.resolve();
    return new Promise((resolve, reject) => {
      loadWaiters.push({ width, resolve, reject });
      worker.postMessage({ type: 'load', width, url: new URL(modelUrl(width), location.href).href, check: CHECKS[String(width)] });
    });
  }

  function think(width: number, bits: Float32Array, asked: Float32Array, questions = QUESTIONS): Promise<[Float32Array, number]> {
    const id = nextId++;
    return new Promise((resolve, reject) => {
      waiting.set(id, { resolve: (p, s) => resolve([p, s]), reject });
      worker.postMessage({ type: 'run', id, width, bits, asked, questions, url: new URL(modelUrl(width), location.href).href },
        [bits.buffer, asked.buffer]);
    });
  }

  function showProgress(fraction: number | null, label: string): void {
    const box = $<HTMLElement>('progress');
    box.hidden = fraction === null;
    if (fraction === null) return;
    $<HTMLElement>('fill').style.width = `${Math.round(Math.min(fraction, 1) * 100)}%`;
    $('progress-label').textContent = label;
  }

  function showError(message: string | null): void {
    const box = $<HTMLParagraphElement>('error');
    box.hidden = message === null;
    box.textContent = message ?? '';
  }

  function random(width: number): bigint {
    const words = new Uint32Array(Math.ceil(width / 32));
    crypto.getRandomValues(words);
    let x = 0n;
    for (const word of words) x = (x << 32n) | BigInt(word);
    return x & ((1n << BigInt(width)) - 1n);
  }

  function fill(target: Float32Array, offset: number, value: bigint, width: number): void {
    for (let k = 0; k < width; k++) target[offset + k] = (value >> BigInt(k)) & 1n ? 1 : -1;
  }

  // The user's own questions: "a, b" per line, decimal or 0x/0b, below 2**width.
  function ownQuestions(width: number): [bigint, bigint][] {
    const limit = 1n << BigInt(width);
    const found: [bigint, bigint][] = [];
    const seen = new Set<string>();
    own.value.split('\n').forEach((line, index) => {
      if (!line.trim()) return;
      const parts = line.split(/[\s,;]+/).filter(Boolean);
      if (parts.length !== 2) throw new Error(`Line ${index + 1}: write two numbers, a and b`);
      const values = parts.map((part) => {
        if (!/^(0x[0-9a-f]+|0b[01]+|\d+)$/i.test(part)) throw new Error(`Line ${index + 1}: "${part}" is not a whole number`);
        const value = BigInt(part.toLowerCase());
        if (value >= limit) throw new Error(`Line ${index + 1}: ${part} does not fit in ${width} bits`);
        return value;
      }) as [bigint, bigint];
      const key = values.join(',');
      if (!seen.has(key)) {
        seen.add(key);
        found.push(values);
      }
    });
    if (found.length > QUESTIONS) throw new Error(`At most ${QUESTIONS} questions of your own`);
    return found;
  }

  async function run(): Promise<void> {
    showError(null);
    const width = Number(widthSelect.value);
    const inputBits = smallBox.checked ? 8 : width;
    let tree;
    let mine: [bigint, bigint][];
    try {
      tree = parse(input.value);
      mine = ownQuestions(width);
    } catch (error) {
      showError((error as Error).message);
      return;
    }
    runButton.disabled = true;
    runButton.textContent = 'Thinking…';
    let ticking = 0;
    try {
      // 999 distinct examples (never one of the questions), then the questions: the user's first, random ones after.
      const seen = new Set<string>(mine.map(([a, b]) => `${a},${b}`));
      const examples: [bigint, bigint][] = [];
      const questions: [bigint, bigint][] = [...mine];
      while (examples.length < CONTEXT || questions.length < QUESTIONS) {
        const a = random(inputBits);
        const b = random(inputBits);
        const key = `${a},${b}`;
        if (seen.has(key)) continue;
        seen.add(key);
        (examples.length < CONTEXT ? examples : questions).push([a, b]);
      }
      const pairs = [...examples, ...questions];
      const answers = pairs.map(([a, b]) => evaluate(tree, a, b, width));
      const distinct = new Set(answers.slice(0, CONTEXT).map(String)).size;
      const bits = new Float32Array(CONTEXT * 3 * width);
      for (let n = 0; n < CONTEXT; n++) {
        fill(bits, n * 3 * width, pairs[n]![0], width);
        fill(bits, (n * 3 + 1) * width, pairs[n]![1], width);
        fill(bits, (n * 3 + 2) * width, answers[n]!, width);
      }
      const asked = new Float32Array(QUESTIONS * 2 * width);
      for (let q = 0; q < QUESTIONS; q++) {
        fill(asked, q * 2 * width, pairs[CONTEXT + q]![0], width);
        fill(asked, (q * 2 + 1) * width, pairs[CONTEXT + q]![1], width);
      }
      await load(width);
      // Estimated progress while the worker thinks; the page stays usable meanwhile.
      const started = performance.now();
      const expected = lastSeconds[width] ?? 5;
      const tick = () => {
        const elapsed = (performance.now() - started) / 1000;
        showProgress(0.95 * (1 - Math.exp(-elapsed / (expected * 0.6))),
          `Reading the 999 examples and answering ${QUESTIONS} questions… ${elapsed.toFixed(1)} s (about ${expected.toFixed(0)} s)`);
        ticking = requestAnimationFrame(tick);
      };
      tick();
      const [p, seconds] = await think(width, bits, asked);
      lastSeconds[width] = seconds;
      cancelAnimationFrame(ticking);
      showProgress(null, '');
      render(width, pairs, answers, p, seconds, distinct, mine.length);
    } catch (error) {
      cancelAnimationFrame(ticking);
      showProgress(null, '');
      showError(`Something went wrong: ${(error as Error).message}`);
    } finally {
      runButton.disabled = false;
      runButton.textContent = 'Ask 16 new questions';
    }
  }

  // The 999 examples, 25 to a page: only the page on screen is built.
  const PAGE = 25;
  let shownExamples: bigint[][] = [];
  let examplePage = 0;
  function showExamples(): void {
    const pages = Math.max(1, Math.ceil(shownExamples.length / PAGE));
    examplePage = Math.min(Math.max(examplePage, 0), pages - 1);
    const start = examplePage * PAGE;
    $('examples').innerHTML = shownExamples
      .slice(start, start + PAGE)
      .map(([a, b, c], k) => `<tr><td class="num muted">${start + k + 1}</td><td class="num">${a}</td><td class="num">${b}</td><td class="num">${c}</td></tr>`)
      .join('');
    $('page-label').textContent = `${start + 1}–${Math.min(start + PAGE, shownExamples.length)} of ${shownExamples.length}`;
    $<HTMLButtonElement>('page-prev').disabled = examplePage === 0;
    $<HTMLButtonElement>('page-next').disabled = examplePage === pages - 1;
  }
  $('page-prev').addEventListener('click', () => {
    examplePage--;
    showExamples();
  });
  $('page-next').addEventListener('click', () => {
    examplePage++;
    showExamples();
  });

  function render(width: number, pairs: [bigint, bigint][], answers: bigint[], p: Float32Array, seconds: number,
    distinct: number, mine: number): void {
    let exact = 0;
    let bitsRight = 0;
    let recoveredSum = 0;
    let sure = 0;
    let sureRight = 0;
    const rows: string[] = [];
    for (let q = 0; q < QUESTIONS; q++) {
      const [a, b] = pairs[CONTEXT + q]!;
      const truth = answers[CONTEXT + q]!;
      let guess = 0n;
      let recovered = width;
      let least = 1;
      const cells: string[] = [];
      for (let k = width - 1; k >= 0; k--) {
        const one = p[q * width + k]!;
        const bit = (truth >> BigInt(k)) & 1n;
        if (one > 0.5) guess |= 1n << BigInt(k);
        recovered += Math.log2(Math.min(Math.max(bit ? one : 1 - one, FLOOR), 1 - FLOOR));
        least = Math.min(least, Math.max(one, 1 - one));
        const right = (one > 0.5) === (bit === 1n);
        if (right) bitsRight++;
        cells.push(`<span class="cell${right ? '' : ' miss'}" style="--p:${one.toFixed(3)}" title="bit ${k}: p(1) = ${one.toFixed(3)}, true ${bit}"></span>`);
      }
      const ok = guess === truth;
      if (ok) exact++;
      if (least >= 0.99) {
        sure++;
        if (ok) sureRight++;
      }
      recoveredSum += recovered;
      const yours = q < mine ? ' <span class="yours">yours</span>' : '';
      rows.push(`<tr><td class="num">${a}${yours}</td><td class="num">${b}</td><td class="num">${truth}</td>
        <td class="num ${ok ? 'ok' : 'bad'}">${guess}${ok ? ' ✓' : ''}</td>
        <td><span class="bits">${cells.join('')}</span></td><td class="num">${recovered.toFixed(1)}</td></tr>`);
    }
    const mean = recoveredSum / QUESTIONS;
    $('exact').textContent = `${exact} / ${QUESTIONS}`;
    $('bits').textContent = `${((bitsRight / (QUESTIONS * width)) * 100).toFixed(1)}%`;
    $('recovered').textContent = mean.toFixed(1);
    $('w').textContent = String(width);
    $('times').textContent = mean > 1 ? `≈ ${formatPower(mean)}× better than a blind guess` : 'about a blind guess';
    $('sure').textContent = `${sure} / ${QUESTIONS} · ${sure ? `${sureRight} / ${sure}` : '—'}`;
    $('note').textContent = `c = ${input.value} at ${width} bits${smallBox.checked ? ' with a, b under 256' : ''}: 999 examples (${distinct.toLocaleString('en-US')} different answers), ${QUESTIONS} new questions${mine ? ` (${mine} of yours)` : ''}, answered on your device's ${where(width)} in ${seconds.toFixed(1)} s.`;
    $('rows').innerHTML = rows.join('');
    shownExamples = pairs.slice(0, CONTEXT).map(([a, b], n) => [a, b, answers[n]!]);
    examplePage = 0;
    showExamples();
    $<HTMLElement>('result').hidden = false;
  }

  function formatPower(bits: number): string {
    const value = 2 ** bits;
    if (value < 1e4) return Math.round(value).toLocaleString('en-US');
    if (value < 1e6) return `${Math.round(value / 1e3).toLocaleString('en-US')} thousand`;
    if (value < 1e9) return `${(value / 1e6).toFixed(1)} million`;
    return `2^${bits.toFixed(0)}`;
  }

  // Random rules, one per line: five on load and five fresh ones (replacing the old) per click on "New rules". Picking
  // a rule only fills it in.
  let shownKind: Kind | 'all' = 'all';
  function line(kind: Kind): HTMLLIElement {
    const rule = generate(kind);
    const item = document.createElement('li');
    const pickButton = document.createElement('button');
    pickButton.type = 'button';
    pickButton.className = 'rule';
    pickButton.innerHTML = `<span class="tag"></span><code></code>`;
    pickButton.querySelector('.tag')!.textContent = KINDS.find((k) => k.kind === kind)!.label.replace(/s$/, '').toLowerCase();
    pickButton.querySelector('code')!.textContent = rule;
    pickButton.title = 'Use this rule';
    pickButton.addEventListener('click', () => {
      input.value = rule;
      input.focus();
    });
    item.append(pickButton);
    return item;
  }
  function fillRules(): void {
    const kinds = shownKind === 'all' ? KINDS.map((k) => k.kind) : Array<Kind>(5).fill(shownKind);
    $('generated').replaceChildren(...kinds.map(line));
  }
  document.querySelectorAll<HTMLButtonElement>('[data-kind]').forEach((button) =>
    button.addEventListener('click', () => {
      shownKind = button.dataset.kind as Kind | 'all';
      document.querySelectorAll('[data-kind]').forEach((b) => b.classList.toggle('active', b === button));
      fillRules();
    }),
  );
  $('again').addEventListener('click', fillRules);
  fillRules();

  document.querySelectorAll<HTMLButtonElement>('[data-formula]').forEach((button) =>
    button.addEventListener('click', () => {
      input.value = button.dataset.formula ?? '';  // fills the rule only; the visitor asks when ready
      input.focus();
    }),
  );
  runButton.addEventListener('click', () => void run());
  widthSelect.addEventListener('change', () => void load(Number(widthSelect.value)).catch(() => undefined));

  // ---- Your own data: a CSV of a, b, c. The first 999 rows are the examples, every later row a question. ----
  const CHUNK = 128; // questions per pass: answers don't depend on the others in the pass, and one pass reads the examples once
  type Row = { a: bigint; b: bigint; c: bigint | null; line: number };
  type Answer = { answer: bigint; confidence: number; recovered: number | null };
  let table: { name: string; examples: Row[]; questions: Row[]; fits16: boolean } | null = null;
  let answers: Answer[] = [];
  let probabilities = new Float32Array(0);
  let csvWidth = 32;
  let stopping = false;
  const csvWidthSelect = $<HTMLSelectElement>('csv-width');

  function csvError(message: string | null): void {
    const box = $<HTMLParagraphElement>('csv-error');
    box.hidden = message === null;
    box.textContent = message ?? '';
  }

  function csvProgress(fraction: number | null, label = ''): void {
    $<HTMLElement>('csv-progress').hidden = fraction === null;
    if (fraction === null) return;
    $<HTMLElement>('csv-fill').style.width = `${Math.round(Math.min(fraction, 1) * 100)}%`;
    $('csv-progress-label').textContent = label;
  }

  const NUMBER = /^(0x[0-9a-f]+|0b[01]+|\d+)$/i;
  function parseCsv(text: string): { examples: Row[]; questions: Row[] } {
    const lines = text.split(/\r?\n/);
    const split = (line: string) => line.split(/[,;\t]/).map((cell) => cell.trim().replace(/^"(.*)"$/, '$1').trim());
    let columns = [0, 1, 2];
    let first = 0;
    while (first < lines.length && !lines[first]!.trim()) first++;
    const head = split(lines[first] ?? '');
    if (head.some((cell) => cell && !NUMBER.test(cell))) {
      // A header row: use columns named a, b, c if there are, else the first three.
      const named = ['a', 'b', 'c'].map((name) => head.findIndex((cell) => cell.toLowerCase() === name));
      if (named[0]! >= 0 && named[1]! >= 0) columns = [named[0]!, named[1]!, named[2]!];
      first++;
    }
    const rows: Row[] = [];
    for (let n = first; n < lines.length; n++) {
      if (!lines[n]!.trim()) continue;
      const cells = split(lines[n]!);
      const value = (column: number, name: string, optional: boolean): bigint | null => {
        const cell = column >= 0 ? (cells[column] ?? '') : '';
        if (!cell) {
          if (optional) return null;
          throw new Error(`Line ${n + 1}: ${name} is missing`);
        }
        if (!NUMBER.test(cell)) throw new Error(`Line ${n + 1}: ${name} = "${cell}" is not a whole number of 0 or more`);
        const v = BigInt(cell.toLowerCase());
        if (v >= 1n << 32n) throw new Error(`Line ${n + 1}: ${name} = ${cell} does not fit in 32 bits`);
        return v;
      };
      rows.push({ a: value(columns[0]!, 'a', false)!, b: value(columns[1]!, 'b', false)!, c: value(columns[2]!, 'c', true), line: n + 1 });
    }
    if (rows.length < CONTEXT) throw new Error(`The file has ${rows.length.toLocaleString('en-US')} rows; it needs 999 examples and then at least one question`);
    const examples = rows.slice(0, CONTEXT);
    const missing = examples.find((row) => row.c === null);
    if (missing) throw new Error(`Line ${missing.line}: the first 999 rows are the examples and each needs c`);
    const questions = rows.slice(CONTEXT);
    if (!questions.length) throw new Error('The file has only the 999 examples; add rows after them for it to answer');
    return { examples, questions };
  }

  $<HTMLInputElement>('csv-file').addEventListener('change', async (event) => {
    const file = (event.target as HTMLInputElement).files?.[0];
    if (!file) return;
    csvError(null);
    $<HTMLElement>('csv-result').hidden = true;
    $<HTMLElement>('csv-download').hidden = true;
    try {
      const { examples, questions } = parseCsv(await file.text());
      const fits16 = [...examples, ...questions].every((r) => r.a < 65536n && r.b < 65536n && (r.c ?? 0n) < 65536n);
      table = { name: file.name, examples, questions, fits16 };
      csvWidthSelect.value = fits16 ? '16' : '32';
      csvWidthSelect.querySelector<HTMLOptionElement>('option[value="16"]')!.disabled = !fits16;
      const scored = questions.filter((q) => q.c !== null).length;
      $('csv-summary').textContent = `${file.name}: 999 examples and ${questions.length.toLocaleString('en-US')} questions${
        scored ? ` (${scored === questions.length ? 'all' : scored.toLocaleString('en-US')} with c, so it can be checked)` : ''}.${
        fits16 ? '' : ' Some numbers need more than 16 bits, so it uses 32.'}`;
      $<HTMLElement>('csv-summary').hidden = false;
      $<HTMLElement>('csv-actions').hidden = false;
      $('csv-run').textContent = `Answer ${questions.length.toLocaleString('en-US')} question${questions.length === 1 ? '' : 's'}`;
      answers = [];
      probabilities = new Float32Array(0);
      csvPage = 0;
      showCsv(0); // the questions, before any answers
    } catch (error) {
      table = null;
      $<HTMLElement>('csv-summary').hidden = true;
      $<HTMLElement>('csv-actions').hidden = true;
      csvError((error as Error).message);
    }
  });

  function duration(seconds: number): string {
    if (seconds < 90) return `${Math.max(1, Math.round(seconds))} s`;
    if (seconds < 5400) return `${Math.round(seconds / 60)} min`;
    return `${(seconds / 3600).toFixed(1)} h`;
  }

  async function runCsv(): Promise<void> {
    if (!table) return;
    const { examples, questions } = table;
    const width = (csvWidth = Number(csvWidthSelect.value));
    const runButton2 = $<HTMLButtonElement>('csv-run');
    const picker = $<HTMLInputElement>('csv-file');
    runButton2.disabled = picker.disabled = csvWidthSelect.disabled = true;
    stopping = false;
    $<HTMLElement>('csv-stop').hidden = false;
    $<HTMLElement>('csv-download').hidden = true;
    csvError(null);
    answers = [];
    probabilities = new Float32Array(questions.length * width);
    const bits = new Float32Array(CONTEXT * 3 * width);
    examples.forEach((row, n) => {
      fill(bits, n * 3 * width, row.a, width);
      fill(bits, (n * 3 + 1) * width, row.b, width);
      fill(bits, (n * 3 + 2) * width, row.c!, width);
    });
    let spent = 0;
    try {
      csvProgress(0, 'Loading the model…');
      await load(width);
      for (let start = 0; start < questions.length && !stopping; start += CHUNK) {
        const chunk = questions.slice(start, start + CHUNK);
        const asked = new Float32Array(chunk.length * 2 * width);
        chunk.forEach((row, q) => {
          fill(asked, q * 2 * width, row.a, width);
          fill(asked, (q * 2 + 1) * width, row.b, width);
        });
        const [p, seconds] = await think(width, bits.slice(), asked, chunk.length);
        spent += seconds;
        probabilities.set(p, start * width);
        chunk.forEach((row, q) => answers.push(score(p.subarray(q * width, (q + 1) * width), row.c, width)));
        const left = (spent / answers.length) * (questions.length - answers.length);
        csvProgress(answers.length / questions.length, `Answered ${answers.length.toLocaleString('en-US')} of ${
          questions.length.toLocaleString('en-US')} on your ${where(width)}${answers.length < questions.length ? `, about ${duration(left)} left` : ''}`);
        showCsv(spent);
      }
      csvProgress(null);
      if (stopping) csvError(`Stopped after ${answers.length.toLocaleString('en-US')} questions; the download has those.`);
    } catch (error) {
      csvProgress(null);
      csvError(`Something went wrong: ${(error as Error).message}`);
    } finally {
      runButton2.disabled = picker.disabled = csvWidthSelect.disabled = false;
      $<HTMLElement>('csv-stop').hidden = true;
      $<HTMLElement>('csv-download').hidden = answers.length === 0;
    }
  }

  function score(p: Float32Array, truth: bigint | null, width: number): Answer {
    let answer = 0n;
    let confidence = 1;
    let recovered: number | null = truth === null ? null : width;
    for (let k = 0; k < width; k++) {
      const one = p[k]!;
      if (one > 0.5) answer |= 1n << BigInt(k);
      confidence = Math.min(confidence, Math.max(one, 1 - one));
      if (recovered !== null) recovered += Math.log2(Math.min(Math.max((truth! >> BigInt(k)) & 1n ? one : 1 - one, FLOOR), 1 - FLOOR));
    }
    return { answer, confidence, recovered };
  }

  const CSV_PAGE = 25;
  let csvPage = 0;
  let csvSpent = 0;
  function showCsv(spent: number): void {
    if (!table) return;
    csvSpent = spent;
    const width = csvWidth;
    const done = answers.length;
    const total = table.questions.length;
    $<HTMLElement>('csv-tiles').hidden = done === 0;
    const scored = table.questions.slice(0, done).map((row, n) => [row, answers[n]!] as const).filter(([row]) => row.c !== null);
    const sure = answers.filter((x) => x.confidence >= 0.99).length;
    $('csv-answered').textContent = `${done.toLocaleString('en-US')} / ${table.questions.length.toLocaleString('en-US')}`;
    $('csv-speed').textContent = `${(spent * 1000 / done).toFixed(0)} ms each on your ${where(width)}, ${width} bits`;
    $('csv-sure').textContent = `${((100 * sure) / done).toFixed(1)}%`;
    $<HTMLElement>('csv-scored').hidden = scored.length === 0;
    if (scored.length) {
      const exact = scored.filter(([row, x]) => row.c === x.answer).length;
      let bitsRight = 0;
      for (const [row, x] of scored) {
        const same = ~(row.c! ^ x.answer) & ((1n << BigInt(width)) - 1n);
        bitsRight += same.toString(2).split('').filter((d) => d === '1').length;
      }
      $('csv-exact').textContent = `${((100 * exact) / scored.length).toFixed(1)}%`;
      $('csv-exact-note').textContent = `${exact.toLocaleString('en-US')} of the ${scored.length.toLocaleString('en-US')} questions with c; ${((100 * bitsRight) / (scored.length * width)).toFixed(1)}% of their bits right`;
    }
    const withTruth = table.questions.some((row) => row.c !== null);
    $('csv-head').innerHTML = `<tr><th class="num">line</th><th class="num">a</th><th class="num">b</th>${withTruth ? '<th class="num">c</th>' : ''}<th class="num">its answer</th><th class="num">confidence</th><th>each bit, high → low</th></tr>`;
    const pages = Math.max(1, Math.ceil(total / CSV_PAGE));
    csvPage = Math.min(Math.max(csvPage, 0), pages - 1);
    const from = csvPage * CSV_PAGE;
    const rows: string[] = [];
    for (let n = from; n < Math.min(from + CSV_PAGE, total); n++) {
      const row = table.questions[n]!;
      const x = answers[n];
      if (!x) {
        rows.push(`<tr><td class="num muted">${row.line}</td><td class="num">${row.a}</td><td class="num">${row.b}</td>${
          withTruth ? `<td class="num">${row.c ?? ''}</td>` : ''}<td class="num muted">—</td><td class="num muted">—</td><td></td></tr>`);
        continue;
      }
      const cells: string[] = [];
      for (let k = width - 1; k >= 0; k--) {
        const one = probabilities[n * width + k]!;
        const miss = row.c !== null && (one > 0.5) !== (((row.c >> BigInt(k)) & 1n) === 1n);
        cells.push(`<span class="cell${miss ? ' miss' : ''}" style="--p:${one.toFixed(3)}" title="bit ${k}: p(1) = ${one.toFixed(3)}"></span>`);
      }
      const verdict = row.c === null ? '' : row.c === x.answer ? 'ok' : 'bad';
      rows.push(`<tr><td class="num muted">${row.line}</td><td class="num">${row.a}</td><td class="num">${row.b}</td>${
        withTruth ? `<td class="num">${row.c ?? ''}</td>` : ''}<td class="num ${verdict}">${x.answer}${verdict === 'ok' ? ' ✓' : ''}</td><td class="num">${
        x.confidence.toFixed(3)}</td><td><span class="bits">${cells.join('')}</span></td></tr>`);
    }
    $('csv-rows').innerHTML = rows.join('');
    $('csv-page').textContent = `questions ${(from + 1).toLocaleString('en-US')}–${Math.min(from + CSV_PAGE, total).toLocaleString('en-US')} of ${
      total.toLocaleString('en-US')}${done && done < total ? ` · ${done.toLocaleString('en-US')} answered` : ''}`;
    $<HTMLButtonElement>('csv-prev').disabled = csvPage === 0;
    $<HTMLButtonElement>('csv-next').disabled = csvPage === pages - 1;
    $<HTMLElement>('csv-result').hidden = false;
  }
  $('csv-prev').addEventListener('click', () => {
    csvPage--;
    showCsv(csvSpent);
  });
  $('csv-next').addEventListener('click', () => {
    csvPage++;
    showCsv(csvSpent);
  });

  function save(name: string, text: string): void {
    const link = document.createElement('a');
    link.href = URL.createObjectURL(new Blob([text], { type: 'text/csv' }));
    link.download = name;
    link.click();
    setTimeout(() => URL.revokeObjectURL(link.href), 1000);
  }

  // One row per answered question: its line in the file, a, b, c if given, the answer, its confidence, whether it was
  // sure, and when c is given whether it was right and the bits recovered; then each bit's probability, high to low.
  $('csv-download').addEventListener('click', () => {
    if (!table) return;
    const width = csvWidth;
    const withTruth = table.questions.some((row) => row.c !== null);
    const bitNames = Array.from({ length: width }, (_, i) => `p_bit${width - 1 - i}`);
    const lines = [['line', 'a', 'b', ...(withTruth ? ['c'] : []), 'answer', 'confidence', 'sure', ...(withTruth ? ['correct', 'bits_recovered'] : []), ...bitNames].join(',')];
    answers.forEach((x, n) => {
      const row = table!.questions[n]!;
      const bitsOut = Array.from({ length: width }, (_, i) => probabilities[n * width + width - 1 - i]!.toFixed(4));
      lines.push([row.line, row.a, row.b, ...(withTruth ? [row.c ?? ''] : []), x.answer, x.confidence.toFixed(4), x.confidence >= 0.99 ? 1 : 0,
        ...(withTruth ? (row.c === null ? ['', ''] : [row.c === x.answer ? 1 : 0, x.recovered!.toFixed(2)]) : []), ...bitsOut].join(','));
    });
    save(`${table.name.replace(/\.[^.]*$/, '')}-answers.csv`, `${lines.join('\n')}\n`);
  });

  // An example file from the rule in the box: 999 examples, then 200 questions with c filled in so they can be checked.
  $('csv-sample').addEventListener('click', () => {
    csvError(null);
    let tree;
    try {
      tree = parse(input.value);
    } catch (error) {
      csvError(`The rule above has a mistake: ${(error as Error).message}`);
      return;
    }
    const width = Number(widthSelect.value);
    const inputBits = smallBox.checked ? 8 : width;
    const seen = new Set<string>();
    const lines = ['a,b,c'];
    while (lines.length <= CONTEXT + 200) {
      const a = random(inputBits);
      const b = random(inputBits);
      if (seen.has(`${a},${b}`)) continue;
      seen.add(`${a},${b}`);
      lines.push(`${a},${b},${evaluate(tree, a, b, width)}`);
    }
    save(`teenie-example-${width}bit.csv`, `${lines.join('\n')}\n`);
  });
  $('csv-run').addEventListener('click', () => void runCsv());
  $('csv-stop').addEventListener('click', () => {
    stopping = true;
    $<HTMLElement>('csv-stop').hidden = true;
  });

  // A link such as /try/?rule=a*10%2Bb&width=16&small=1 opens with that rule (from the overview's puzzles and wall).
  const params = new URLSearchParams(location.search);
  if (params.get('rule')) input.value = params.get('rule')!;
  if (params.get('width') === '16' || params.get('width') === '32') widthSelect.value = params.get('width')!;
  if (params.get('small') === '1') smallBox.checked = true;

  load(Number(widthSelect.value))
    .then(() => {
      showProgress(null, '');
      $('status').innerHTML = '<span class="dot"></span> Model loaded. Pick a rule or type your own, then press <b>Ask 16 questions</b>; it runs on your device, in a background thread.';
      runButton.disabled = false;
    })
    .catch((error: Error) => {
      showProgress(null, '');
      $('status').textContent = `Could not load the model in this browser (${error.message}).`;
    });
</script>

