// Cloudflare Workers config for the static docs site.
// Deployed through the Cloudflare GitHub integration (Workers Builds) with:
//   Root directory: site
//   Build command:  pnpm build:static   (no Try it page: it needs the local Python relay)
//   Deploy command: npx wrangler deploy
//   Public address: https://teenie.lupyd.com (the default in astro.config.ts; SITE_URL overrides it)
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "teenie",
  "compatibility_date": "2026-11-01",
  // No Worker script: serve the Astro output in dist/ as static assets.
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
}
